#include "tlpp-core.th"
#include "totvs.ch"

#define RS_PARAM_LOAD "PXFINR25"
#define RS_RISCO_SIM  "S"

// Posições do array de parâmetros (ParamBox)
#define PAR_FILDE     1
#define PAR_FILATE    2
#define PAR_LOTEDE    3
#define PAR_LOTEATE   4
#define PAR_SITUAC    5

/*/{Protheus.doc} PXFINR25
Relatório de Lotes de Risco Sacado (Contas a Pagar).
Lista os títulos a pagar dos fornecedores por filial/lote com banco, data de envio, situação,
valores e, para os antecipados, o título a pagar do banco gerado e o valor líquido (RISK-001).
Totais por lote e geral.

Parâmetros (ParamBox - última seleção salva por usuário, sem dependência de SX1):
  01 Filial de / 02 Filial até / 03 Lote de / 04 Lote até /
  05 Situação (1=Todas;2=Disponível;3=Antecipado;4=Em aberto)

@type user function
@author bacoetrom
@since 19/10/2026
@return logical, .T. quando o relatório foi exibido
/*/
User Function PXFINR25() as logical
    Local aPar    := {} as array
    Local oReport as object

    If !U_PXRSDicionario()
        FWAlertError("Campos do risco sacado não criados no dicionário (E2_X*, A6_XFORN, A6_XLOJA). " + ;
                     "Crie os campos conforme DICIONARIO.md do projeto.", "Lotes de Risco Sacado")
        Return .F.
    EndIf

    aPar := Parametros()
    If Empty(aPar)
        Return .F.
    EndIf

    oReport := ReportDef(aPar)
    oReport:PrintDialog()
Return .T.

/*/{Protheus.doc} Parametros
Exibe a tela de parâmetros (ParamBox) e devolve as respostas.
A situação (combo) é normalizada para numérico.
@type static function
@author bacoetrom
@since 19/10/2026
@return array, respostas na ordem das constantes PAR_* ou vazio quando cancelado
/*/
Static Function Parametros() as array
    Local aPergs    := {} as array
    Local aRet      := {} as array
    Local aSituacao := {} as array
    Local nTamFil   := TamSX3("E2_FILIAL")[1] as numeric
    Local nTamLote  := TamSX3("E2_XLOTRS")[1] as numeric

    aSituacao := {"1-Todas", "2-Disponível", "3-Antecipado", "4-Em aberto"}

    aAdd(aPergs, {1, "Filial de" , Space(nTamFil)          , "@!", ".T.", "SM0", ".T.", 50, .F.})
    aAdd(aPergs, {1, "Filial até", Replicate("Z", nTamFil) , "@!", ".T.", "SM0", ".T.", 50, .T.})
    aAdd(aPergs, {1, "Lote de"   , Space(nTamLote)         , "@!", ".T.", ""   , ".T.", 40, .F.})
    aAdd(aPergs, {1, "Lote até"  , Replicate("Z", nTamLote), "@!", ".T.", ""   , ".T.", 40, .T.})
    aAdd(aPergs, {2, "Situação"  , aSituacao[1]            , aSituacao, 90, ".T.", .T.})

    If !ParamBox(aPergs, "Lotes de Risco Sacado - Parâmetros", @aRet, , , , , , , RS_PARAM_LOAD, .T., .T.)
        Return {}
    EndIf

    If ValType(aRet[PAR_SITUAC]) == "C"
        aRet[PAR_SITUAC] := Val(Left(aRet[PAR_SITUAC], 1))
    EndIf
Return aRet

/*/{Protheus.doc} ReportDef
Definição do relatório (TReport).
@type static function
@author bacoetrom
@since 19/10/2026
@param aPar, array, respostas dos parâmetros (ParamBox)
@return object, instância de TReport
/*/
Static Function ReportDef(aPar as array) as object
    Local cAlias   := GetNextAlias() as character
    Local oReport  as object
    Local oSection as object
    Local oBreak   as object

    oReport := TReport():New("PXFINR25", "Lotes de Risco Sacado", , {|oRep| ReportPrint(oRep, cAlias, aPar)}, ;
                             "Relação dos títulos a pagar disponibilizados ao banco em Risco Sacado, por lote.")
    oReport:SetLandscape()
    oReport:SetTotalInLine(.F.)

    oSection := TRSection():New(oReport, "Títulos do lote", {"SE2"})
    TRCell():New(oSection, "FILIAL"  , , "Filial"       , "@!"                  , TamSX3("E2_FILIAL")[1]  , , {|| (cAlias)->E2_FILIAL})
    TRCell():New(oSection, "LOTE"    , , "Lote"         , "@!"                  , TamSX3("E2_XLOTRS")[1]  , , {|| (cAlias)->E2_XLOTRS})
    TRCell():New(oSection, "BANCO"   , , "Banco"        , "@!"                  , TamSX3("E2_XBANCO")[1]  , , {|| (cAlias)->E2_XBANCO})
    TRCell():New(oSection, "DTENVIO" , , "Dt. Envio"    , ""                    , 10                      , , {|| StoD((cAlias)->E2_XDTRISC)})
    TRCell():New(oSection, "SITUACAO", , "Situação"     , "@!"                  , 12                      , , {|| U_PXRSDescSituacao((cAlias)->E2_XRISCO, (cAlias)->E2_XSTRIC)})
    TRCell():New(oSection, "PREFIXO" , , "Prefixo"      , "@!"                  , TamSX3("E2_PREFIXO")[1] , , {|| (cAlias)->E2_PREFIXO})
    TRCell():New(oSection, "NUMERO"  , , "Número"       , "@!"                  , TamSX3("E2_NUM")[1]     , , {|| (cAlias)->E2_NUM})
    TRCell():New(oSection, "PARCELA" , , "Parcela"      , "@!"                  , TamSX3("E2_PARCELA")[1] , , {|| (cAlias)->E2_PARCELA})
    TRCell():New(oSection, "TIPO"    , , "Tipo"         , "@!"                  , TamSX3("E2_TIPO")[1]    , , {|| (cAlias)->E2_TIPO})
    TRCell():New(oSection, "FORNECE" , , "Fornecedor"   , "@!"                  , TamSX3("E2_FORNECE")[1] , , {|| (cAlias)->E2_FORNECE})
    TRCell():New(oSection, "LOJA"    , , "Loja"         , "@!"                  , TamSX3("E2_LOJA")[1]    , , {|| (cAlias)->E2_LOJA})
    TRCell():New(oSection, "NOME"    , , "Nome"         , "@!"                  , TamSX3("E2_NOMFOR")[1]  , , {|| (cAlias)->E2_NOMFOR})
    TRCell():New(oSection, "VENCREA" , , "Vencto Real"  , ""                    , 10                      , , {|| StoD((cAlias)->E2_VENCREA)})
    TRCell():New(oSection, "VALOR"   , , "Valor"        , X3Picture("E2_VALOR") , TamSX3("E2_VALOR")[1]   , , {|| (cAlias)->E2_VALOR})
    TRCell():New(oSection, "SALDO"   , , "Saldo"        , X3Picture("E2_SALDO") , TamSX3("E2_SALDO")[1]   , , {|| (cAlias)->E2_SALDO})
    TRCell():New(oSection, "DTANT"   , , "Dt.Antecip."  , ""                    , 10                      , , {|| StoD((cAlias)->E2_XDTANT)})
    TRCell():New(oSection, "TITBCO"  , , "Título Banco" , "@!"                  , 20                      , , {|| AllTrim((cAlias)->BCOPRF) + "/" + AllTrim((cAlias)->BCONUM)})
    TRCell():New(oSection, "VLRBCO"  , , "Valor Banco"  , X3Picture("E2_VALOR") , TamSX3("E2_VALOR")[1]   , , {|| (cAlias)->BCOVLR})
    TRCell():New(oSection, "RETENC"  , , "Retenções"    , X3Picture("E2_VALOR") , TamSX3("E2_VALOR")[1]   , , {|| Retencoes(cAlias)})

    oBreak := TRBreak():New(oSection, {|| (cAlias)->(E2_FILIAL + E2_XLOTRS)}, "Total do lote:", .F.)
    TRFunction():New(oSection:Cell("NUMERO"), "QTDLOTE", "COUNT", oBreak,,,, .F., .T.)
    TRFunction():New(oSection:Cell("VALOR") , "VLRLOTE", "SUM"  , oBreak,,,, .F., .T.)
    TRFunction():New(oSection:Cell("SALDO") , "SLDLOTE", "SUM"  , oBreak,,,, .F., .T.)
    TRFunction():New(oSection:Cell("VLRBCO"), "BCOLOTE", "SUM"  , oBreak,,,, .F., .T.)
    TRFunction():New(oSection:Cell("RETENC"), "RETLOTE", "SUM"  , oBreak,,,, .F., .T.)
Return oReport

/*/{Protheus.doc} Retencoes
Diferença entre o valor do título original e o valor do título do banco (retenções na baixa).
@type static function
@author bacoetrom
@since 19/10/2026
@param cAlias, character, alias da consulta
@return numeric, valor retido (0 quando não antecipado)
/*/
Static Function Retencoes(cAlias as character) as numeric
    Local nRet := 0 as numeric

    If (cAlias)->BCOVLR > 0
        nRet := (cAlias)->E2_VALOR - (cAlias)->BCOVLR
    EndIf
Return nRet

/*/{Protheus.doc} ReportPrint
Impressão do relatório: seleciona os títulos dos lotes (com o título do banco gerado) e imprime as linhas.
@type static function
@author bacoetrom
@since 19/10/2026
@param oReport, object, instância de TReport
@param cAlias, character, alias da consulta
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, sempre .T.
/*/
Static Function ReportPrint(oReport as object, cAlias as character, aPar as array) as logical
    Local aBind      := {} as array
    Local cQuery     := "" as character
    Local cConcat    := "" as character
    Local nI         := 0 as numeric
    Local nSituac    := 0 as numeric
    Local oSection   := oReport:Section(1) as object
    Local oStatement as object

    nSituac := aPar[PAR_SITUAC]
    // Chave de origem gravada no título do banco (E2_XORIRS) - concatenação convertida pelo ChangeQuery
    cConcat := "SE2.E2_FILIAL || SE2.E2_PREFIXO || SE2.E2_NUM || SE2.E2_PARCELA || SE2.E2_TIPO || SE2.E2_FORNECE || SE2.E2_LOJA"

    cQuery := "SELECT SE2.E2_FILIAL, SE2.E2_XLOTRS, SE2.E2_XBANCO, SE2.E2_XDTRISC, SE2.E2_XRISCO, SE2.E2_XSTRIC, "
    cQuery += "       SE2.E2_PREFIXO, SE2.E2_NUM, SE2.E2_PARCELA, SE2.E2_TIPO, SE2.E2_FORNECE, SE2.E2_LOJA, "
    cQuery += "       SE2.E2_NOMFOR, SE2.E2_VENCREA, SE2.E2_VALOR, SE2.E2_SALDO, SE2.E2_XDTANT, "
    cQuery += "       COALESCE(BCO.E2_PREFIXO, ' ') BCOPRF, COALESCE(BCO.E2_NUM, ' ') BCONUM, COALESCE(BCO.E2_VALOR, 0) BCOVLR "
    cQuery += "  FROM " + RetSqlName("SE2") + " SE2 "
    cQuery += "  LEFT JOIN " + RetSqlName("SE2") + " BCO "
    cQuery += "    ON BCO.E2_FILIAL = SE2.E2_FILIAL "
    // RTRIM nos dois lados: E2_XORIRS é maior que a chave (evita diferença de espaços entre bancos de dados)
    cQuery += "   AND RTRIM(BCO.E2_XORIRS) = RTRIM(" + cConcat + ") "
    cQuery += "   AND BCO.D_E_L_E_T_ = ? "
    aAdd(aBind, " ")
    cQuery += " WHERE SE2.D_E_L_E_T_ = ? "
    aAdd(aBind, " ")
    cQuery += "   AND SE2.E2_FILIAL BETWEEN ? AND ? "
    aAdd(aBind, aPar[PAR_FILDE])
    aAdd(aBind, aPar[PAR_FILATE])
    cQuery += "   AND SE2.E2_XLOTRS BETWEEN ? AND ? "
    aAdd(aBind, aPar[PAR_LOTEDE])
    aAdd(aBind, aPar[PAR_LOTEATE])
    cQuery += "   AND SE2.E2_XLOTRS <> ? "
    aAdd(aBind, Space(TamSX3("E2_XLOTRS")[1]))
    cQuery += "   AND SE2.E2_XRISCO = ? "
    aAdd(aBind, RS_RISCO_SIM)
    If nSituac >= 2 .And. nSituac <= 4
        cQuery += "   AND SE2.E2_XSTRIC = ? "
        aAdd(aBind, cValToChar(nSituac - 1))
    EndIf
    cQuery += " ORDER BY SE2.E2_FILIAL, SE2.E2_XLOTRS, SE2.E2_PREFIXO, SE2.E2_NUM, SE2.E2_PARCELA, SE2.E2_TIPO "

    oStatement := FWExecStatement():New(ChangeQuery(cQuery))
    For nI := 1 To Len(aBind)
        oStatement:SetString(nI, aBind[nI])
    Next nI
    oStatement:OpenAlias(cAlias)

    oSection:Init()
    While !(cAlias)->(Eof())
        If oReport:Cancel()
            Exit
        EndIf
        oSection:PrintLine()
        (cAlias)->(DbSkip())
    EndDo
    oSection:Finish()

    (cAlias)->(DbCloseArea())
    oStatement:Destroy()
    oStatement := Nil
Return .T.
