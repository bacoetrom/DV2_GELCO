#include "tlpp-core.th"
#include "totvs.ch"

#define RS_RISCO_SIM    "S"
#define RS_DISPONIVEL   "1"
#define RS_ANTECIPADO   "2"
#define RS_EM_ABERTO    "3"
#define RS_PROCESSANDO  "9"
#define RS_TOLERANCIA   0.0049
#define RS_TAM_SEQ      3

/*/{Protheus.doc} PXFINA37S
Serviços do processo de Risco Sacado em Contas a Pagar (SE2).
Funções compartilhadas pela tela PXFINA37, pelos pontos de entrada
(FINM020, FA080TIT, FA050UPD, F240TIT) e pelo relatório PXFINR25.

Domínio do campo E2_XSTRIC:
  1 = Disponível       (enviado ao banco; movimentação somente pela rotina PXFINA37)
  2 = Antecipado       (original baixado pela rotina + SE2 gerado para o banco; movimentação somente pela rotina)
  3 = Em aberto        (fornecedor não antecipou; título segue o fluxo normal)
  9 = Em processamento (antecipação ou estorno interrompido por erro; resolver pela ação Conciliar da PXFINA37)

Atomicidade da antecipação (1 -> 2) e do estorno (2 -> 1):
  As rotinas automáticas FINA080 (baixa) e FINA050 (inclusão) controlam a própria transação e o
  End Transaction do FINA080 encerra a transação ao final da baixa. Por isso NÃO existe transação
  envolvendo os ExecAuto: a baixa já está efetivada quando a inclusão do título do banco falha, e
  DisarmTransaction() não teria efeito sobre ela. A rotina grava a situação 9 antes de qualquer
  ExecAuto, confere cada passo no banco de dados e, quando um passo falha, compensa os passos
  anteriores. Quando a própria compensação falha, o título permanece na situação 9 e é resolvido
  pela ação Conciliar (U_PXRSConcilia), que decide pelo estado real dos registros.

Parâmetros:
  MV_XRSNAT - Natureza do título a pagar do banco
  MV_XRSPRF - Prefixo do título a pagar do banco
  MV_XRSTIP - Tipo do título a pagar do banco
  MV_XRSMOT - Motivo de baixa da antecipação (sem movimentação bancária)
  MV_XRSLOG - Liga log de diagnóstico (FWLogMsg) dos pontos de entrada

@type function
@author bacoetrom
@since 19/10/2026
/*/

/*/{Protheus.doc} PXRSChaveOrigem
Monta a chave do título a pagar posicionado (gravada em E2_XORIRS do título do banco).
@type user function
@author bacoetrom
@since 19/10/2026
@return character, E2_FILIAL + E2_PREFIXO + E2_NUM + E2_PARCELA + E2_TIPO + E2_FORNECE + E2_LOJA
/*/
User Function PXRSChaveOrigem() as character
Return SE2->(E2_FILIAL + E2_PREFIXO + E2_NUM + E2_PARCELA + E2_TIPO + E2_FORNECE + E2_LOJA)

/*/{Protheus.doc} PXRSDescSituacao
Retorna a descrição da situação de risco sacado.
@type user function
@author bacoetrom
@since 19/10/2026
@param cRisco, character, conteúdo de E2_XRISCO
@param cStatus, character, conteúdo de E2_XSTRIC
@return character, descrição da situação
/*/
User Function PXRSDescSituacao(cRisco as character, cStatus as character) as character
    Local cDesc := "Sem risco" as character

    If cRisco == RS_RISCO_SIM
        If cStatus == RS_DISPONIVEL
            cDesc := "Disponível"
        ElseIf cStatus == RS_ANTECIPADO
            cDesc := "Antecipado"
        ElseIf cStatus == RS_EM_ABERTO
            cDesc := "Em aberto"
        ElseIf cStatus == RS_PROCESSANDO
            cDesc := "Em processamento"
        Else
            cDesc := "Risco sem situação"
        EndIf
    EndIf
Return cDesc

/*/{Protheus.doc} PXRSFornBanco
Retorna o fornecedor/loja configurado no banco (A6_XFORN/A6_XLOJA).
Como E2_XBANCO guarda apenas o código do banco, é usada a primeira
agência/conta do banco que possua o fornecedor preenchido.
@type user function
@author bacoetrom
@since 19/10/2026
@param cFilTit, character, filial do título (para o xFilial da SA6)
@param cBanco, character, código do banco (A6_COD)
@return array, {cFornecedor, cLoja} - vazios quando não configurado
/*/
User Function PXRSFornBanco(cFilTit as character, cBanco as character) as array
    Local aArea    := GetArea() as array
    Local aAreaSA6 := SA6->(GetArea()) as array
    Local aRet     := {"", ""} as array
    Local cChave   := "" as character

    cChave := xFilial("SA6", cFilTit) + cBanco
    SA6->(DbSetOrder(1)) // A6_FILIAL+A6_COD+A6_AGENCIA+A6_NUMCON
    // Campos do dicionário ainda não criados: retorna vazio em vez de gerar erro de execução
    If SA6->(FieldPos("A6_XFORN")) > 0 .And. SA6->(FieldPos("A6_XLOJA")) > 0 .And. SA6->(DbSeek(cChave))
        While !SA6->(Eof()) .And. SA6->(A6_FILIAL + A6_COD) == cChave
            If !Empty(SA6->A6_XFORN)
                aRet := {SA6->A6_XFORN, SA6->A6_XLOJA}
                Exit
            EndIf
            SA6->(DbSkip())
        EndDo
    EndIf

    RestArea(aAreaSA6)
    RestArea(aArea)
Return aRet

/*/{Protheus.doc} PXRSDicionario
Indica se os campos do risco sacado existem no dicionário (SE2 e SA6).
@type user function
@author bacoetrom
@since 19/10/2026
@return logical, .T. quando todos os campos existem
/*/
User Function PXRSDicionario() as logical
Return SE2->(FieldPos("E2_XRISCO")) > 0 .And. SE2->(FieldPos("E2_XSTRIC")) > 0 .And. ;
       SE2->(FieldPos("E2_XLOTRS")) > 0 .And. SE2->(FieldPos("E2_XBANCO")) > 0 .And. ;
       SE2->(FieldPos("E2_XDTRISC")) > 0 .And. SE2->(FieldPos("E2_XDTANT")) > 0 .And. ;
       SE2->(FieldPos("E2_XORIRS")) > 0 .And. ;
       SA6->(FieldPos("A6_XFORN")) > 0 .And. SA6->(FieldPos("A6_XLOJA")) > 0

/*/{Protheus.doc} PXRSConfig
Lê uma única vez os parâmetros do risco sacado (fora de laços).
@type user function
@author bacoetrom
@since 19/10/2026
@return json, {nat, prf, tip, mot}
/*/
User Function PXRSConfig() as json
    Local jCfg := JsonObject():New() as json

    jCfg["nat"] := PadR(SuperGetMV("MV_XRSNAT", .F., "000001"), TamSX3("E2_NATUREZ")[1])
    jCfg["prf"] := PadR(SuperGetMV("MV_XRSPRF", .F., "1"), TamSX3("E2_PREFIXO")[1])
    jCfg["tip"] := PadR(SuperGetMV("MV_XRSTIP", .F., "NF"), TamSX3("E2_TIPO")[1])
    jCfg["mot"] := AllTrim(SuperGetMV("MV_XRSMOT", .F., "ATP"))
Return jCfg

/*/{Protheus.doc} PXRSValidaConfig
Valida dicionário e parâmetros necessários para a antecipação na filial do título.
@type user function
@author bacoetrom
@since 19/10/2026
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@param cFilTit, character, filial do título
@return character, mensagem de erro ou vazio quando válido
/*/
User Function PXRSValidaConfig(jCfg as json, cFilTit as character) as character
    Local aArea    := GetArea() as array
    Local aAreaSED := SED->(GetArea()) as array
    Local aMotBx   := {} as array
    Local cMsg     := "" as character

    SED->(DbSetOrder(1)) // ED_FILIAL+ED_CODIGO

    If !U_PXRSDicionario()
        cMsg := "Campos do risco sacado não criados no dicionário (E2_X*, A6_XFORN, A6_XLOJA). Crie os campos conforme DICIONARIO.md do projeto."
    ElseIf Empty(jCfg["nat"])
        cMsg := "Parâmetro MV_XRSNAT (natureza do título a pagar do banco) não informado."
    ElseIf !SED->(DbSeek(xFilial("SED", cFilTit) + jCfg["nat"]))
        cMsg := "Natureza '" + AllTrim(jCfg["nat"]) + "' do parâmetro MV_XRSNAT não cadastrada."
    ElseIf Empty(jCfg["prf"])
        cMsg := "Parâmetro MV_XRSPRF (prefixo do título a pagar do banco) não informado."
    ElseIf Empty(jCfg["tip"])
        cMsg := "Parâmetro MV_XRSTIP (tipo do título a pagar do banco) não informado."
    ElseIf Empty(jCfg["mot"])
        cMsg := "Parâmetro MV_XRSMOT (motivo de baixa da antecipação) não informado."
    Else
        aMotBx := ReadMotBx()
        If aScan(aMotBx, {|x| Upper(Left(x, 3)) == Upper(PadR(jCfg["mot"], 3))}) == 0
            cMsg := "Motivo de baixa '" + jCfg["mot"] + "' (MV_XRSMOT) não cadastrado nos motivos de baixa do Financeiro."
        ElseIf MovBcoBx(jCfg["mot"])
            cMsg := "Motivo de baixa '" + jCfg["mot"] + "' (MV_XRSMOT) movimenta banco. Configure o motivo sem movimentação bancária."
        EndIf
    EndIf

    RestArea(aAreaSED)
    RestArea(aArea)
Return cMsg

/*/{Protheus.doc} PXRSValidaElegivel
Verifica se o título posicionado na SE2 pode ser disponibilizado ao banco.
@type user function
@author bacoetrom
@since 19/10/2026
@param cFornBco, character, fornecedor do banco (A6_XFORN)
@param cLojaBco, character, loja do fornecedor do banco (A6_XLOJA)
@return character, motivo da rejeição ou vazio quando elegível
/*/
User Function PXRSValidaElegivel(cFornBco as character, cLojaBco as character) as character
    Local cMotivo := "" as character
    Local cTipo   := "" as character

    cTipo := AllTrim(SE2->E2_TIPO)

    If SE2->(Eof())
        cMotivo := "título não encontrado."
    ElseIf SE2->E2_XRISCO == RS_RISCO_SIM
        cMotivo := "título já está em risco sacado (lote " + AllTrim(SE2->E2_XLOTRS) + ")."
    ElseIf !Empty(SE2->E2_XORIRS)
        cMotivo := "título a pagar do banco gerado pelo risco sacado não pode ser disponibilizado."
    ElseIf SE2->E2_SALDO <= 0
        cMotivo := "título já baixado."
    ElseIf SE2->E2_SALDO < SE2->E2_VALOR - RS_TOLERANCIA
        cMotivo := "título com baixa parcial."
    ElseIf !Empty(SE2->E2_NUMBOR)
        cMotivo := "título está no borderô " + AllTrim(SE2->E2_NUMBOR) + "."
    ElseIf Substr(SE2->E2_TIPO, 3, 1) == "-" .Or. aScan({"PA", "NDF", "PR", "TX", "ISS", "INS"}, cTipo) > 0
        cMotivo := "tipo " + cTipo + " não é permitido no risco sacado."
    ElseIf SE2->(E2_FORNECE + E2_LOJA) == cFornBco + cLojaBco
        cMotivo := "o fornecedor do título é o próprio fornecedor do banco."
    EndIf
Return cMotivo

/*/{Protheus.doc} PXRSBuscaPagar
Localiza o título a pagar do banco gerado a partir do título de origem.
@type user function
@author bacoetrom
@since 19/10/2026
@param cFilTit, character, filial do título de origem
@param cChave, character, chave de origem (U_PXRSChaveOrigem)
@return numeric, R_E_C_N_O_ da SE2 do banco ou 0 quando não existir
/*/
User Function PXRSBuscaPagar(cFilTit as character, cChave as character) as numeric
    Local cQuery     := "" as character
    Local nRecno     := 0 as numeric
    Local xRet       as variant
    Local oStatement as object

    cQuery := "SELECT MAX(SE2.R_E_C_N_O_) RECSE2 "
    cQuery += "  FROM " + RetSqlName("SE2") + " SE2 "
    cQuery += " WHERE SE2.D_E_L_E_T_ = ? "
    cQuery += "   AND SE2.E2_FILIAL = ? "
    cQuery += "   AND SE2.E2_XORIRS = ? "

    oStatement := FWExecStatement():New(ChangeQuery(cQuery))
    oStatement:SetString(1, " ")
    oStatement:SetString(2, xFilial("SE2", cFilTit))
    oStatement:SetString(3, PadR(cChave, TamSX3("E2_XORIRS")[1]))
    xRet := oStatement:ExecScalar("RECSE2")
    oStatement:Destroy()
    oStatement := Nil

    If ValType(xRet) == "N"
        nRecno := xRet
    EndIf
Return nRecno

/*/{Protheus.doc} PXRSAntecipa
Antecipação de um título Disponível, em passos conferidos no banco de dados:
  1. grava a situação 9 (Em processamento) no título original;
  2. baixa total do título do fornecedor (ExecAuto FINA080, motivo MV_XRSMOT, sem movimentação bancária);
  3. inclusão do título a pagar do banco pelo valor líquido baixado (ExecAuto FINA050);
  4. situação 2 (Antecipado) e data da antecipação no título original.

NÃO existe transação envolvendo os ExecAuto: o End Transaction do próprio FINA080 encerra a
transação ao final da baixa, portanto a baixa já está efetivada quando o passo 3 falha e
DisarmTransaction() não a desfaria. A falha após a baixa executa a compensação (exclusão do
título do banco quando existir e cancelamento da baixa - FINA080 opção 5). Quando a compensação
também falha, o título permanece na situação 9 para a ação Conciliar da rotina PXFINA37.

O número do título do banco é gerado antes da baixa: assim uma falha na numeração não deixa o
título baixado.

Não usa interface: as mensagens retornam ao chamador.
@type user function
@author bacoetrom
@since 19/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@return character, mensagem de erro ou vazio quando antecipado com sucesso
/*/
User Function PXRSAntecipa(nRecSE2 as numeric, jCfg as json) as character
    Local aArea    := GetArea() as array
    Local aAreaSE2 := SE2->(GetArea()) as array
    Local aForn    := {"", ""} as array
    Local cMsg     := "" as character
    Local cChave   := "" as character
    Local cLock    := "" as character
    Local cNomLock := "" as character
    Local cNumero  := "" as character
    Local cFilAux  := "" as character
    Local cLoteAux := "" as character
    Local oErro    as object

    SE2->(DbGoTo(nRecSE2))
    cChave   := U_PXRSChaveOrigem()
    cFilAux  := SE2->E2_FILIAL
    cLoteAux := SE2->E2_XLOTRS

    If InTransact()
        cMsg := "antecipação chamada dentro de uma transação aberta. Execute a ação pela rotina Risco Sacado (PXFINA37)."
        U_PXRSLog("ERROR", "Antecipação abortada (transação aberta): " + AllTrim(cChave))
    Else
        cMsg := ValidaAntecipa(jCfg, @aForn)
    EndIf

    // Serializa a geração do número do título do banco por filial/lote.
    // cLock só é preenchido quando o semáforo foi realmente obtido.
    If Empty(cMsg)
        cNomLock := "PXRS" + AllTrim(cFilAux) + AllTrim(cLoteAux)
        If LockByName(cNomLock, .T., .F.)
            cLock := cNomLock
        Else
            cMsg := "lote " + AllTrim(cLoteAux) + " em processamento por outro usuário. Tente novamente."
        EndIf
    EndIf

    // Numeração antes da baixa: falha aqui não deixa o título baixado
    If Empty(cMsg)
        cNumero := ProximoNumero(cFilAux, cLoteAux, jCfg, aForn)
        If Empty(cNumero)
            cMsg := "não foi possível gerar o número do título do banco para o lote " + AllTrim(cLoteAux) + ;
                    " (tamanho de E2_NUM insuficiente ou sequência esgotada)."
        EndIf
    EndIf

    If Empty(cMsg)
        Try
            cMsg := ExecutaAntecipa(nRecSE2, jCfg, aForn, cNumero, cChave)
        Catch oErro
            cMsg := "erro inesperado na antecipação: " + oErro:Description
            U_PXRSLog("ERROR", "Antecipação " + AllTrim(cChave) + " - " + cMsg)
            cMsg += CRLF + CompensaFalha(nRecSE2, cChave)
        EndTry
    EndIf

    If !Empty(cLock)
        UnLockByName(cLock, .T., .F.)
    EndIf

    If Empty(cMsg)
        U_PXRSLog("INFO", "Antecipado: " + AllTrim(cChave) + " - título do banco " + AllTrim(jCfg["prf"]) + "/" + ;
                          AllTrim(cNumero) + " - usuário " + AllTrim(UsrRetName(RetCodUsr())))
    Else
        U_PXRSLog("WARN", "Antecipação rejeitada: " + AllTrim(cChave) + " - " + cMsg)
    EndIf

    RestArea(aAreaSE2)
    RestArea(aArea)
Return cMsg

/*/{Protheus.doc} ValidaAntecipa
Valida se o título posicionado na SE2 pode ser antecipado e devolve o fornecedor do banco.
@type static function
@author bacoetrom
@since 28/10/2026
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@param aForn, array, recebido por referência (@) e preenchido com {fornecedor, loja} do banco
@return character, motivo da rejeição ou vazio quando válido
/*/
Static Function ValidaAntecipa(jCfg as json, aForn as array) as character
    Local cMsg   := "" as character
    Local cChave := "" as character

    cChave := U_PXRSChaveOrigem()

    If SE2->(Eof()) .Or. SE2->E2_XRISCO <> RS_RISCO_SIM
        cMsg := "título não está em risco sacado."
    ElseIf SE2->E2_XSTRIC == RS_PROCESSANDO
        cMsg := "título está Em processamento (antecipação anterior interrompida). Use a ação Conciliar da rotina."
    ElseIf SE2->E2_XSTRIC <> RS_DISPONIVEL
        cMsg := "título não está Disponível no risco sacado."
    ElseIf SE2->E2_FILIAL <> xFilial("SE2")
        cMsg := "título de outra filial. Acesse a filial " + AllTrim(SE2->E2_FILIAL) + " para antecipar."
    ElseIf SE2->E2_SALDO < SE2->E2_VALOR - RS_TOLERANCIA .Or. !Empty(SE2->E2_NUMBOR)
        cMsg := "título com baixa ou em borderô após a disponibilização."
    ElseIf U_PXRSBuscaPagar(SE2->E2_FILIAL, cChave) > 0
        cMsg := "já existe título a pagar do banco gerado para este título."
    Else
        cMsg := U_PXRSValidaConfig(jCfg, SE2->E2_FILIAL)
    EndIf

    If Empty(cMsg)
        aForn := U_PXRSFornBanco(SE2->E2_FILIAL, SE2->E2_XBANCO)
        If Empty(aForn[1])
            cMsg := "banco '" + AllTrim(SE2->E2_XBANCO) + "' sem fornecedor (A6_XFORN/A6_XLOJA) informado."
        EndIf
    EndIf
Return cMsg

/*/{Protheus.doc} ExecutaAntecipa
Executa os passos da antecipação, conferindo cada um pelo estado dos registros (U_PXRSEstadoTitulo)
e não apenas pelo retorno do ExecAuto. Qualquer falha após a baixa dispara a compensação.
@type static function
@author bacoetrom
@since 28/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@param aForn, array, {fornecedor, loja} do banco
@param cNumero, character, número já reservado para o título do banco
@param cChave, character, chave de origem (U_PXRSChaveOrigem)
@return character, mensagem de erro ou vazio quando antecipado
/*/
Static Function ExecutaAntecipa(nRecSE2 as numeric, jCfg as json, aForn as array, cNumero as character, cChave as character) as character
    Local cMsg   := "" as character
    Local nValor := 0 as numeric
    Local jEst   as json

    cMsg := U_PXRSMarcaStatus(nRecSE2, RS_PROCESSANDO, Nil)
    If !Empty(cMsg)
        Return cMsg
    EndIf

    cMsg := BaixaOriginal(nRecSE2, jCfg)
    jEst := U_PXRSEstadoTitulo(nRecSE2)
    U_PXRSLog("INFO", "Antecipação " + AllTrim(cChave) + " - passo baixa: erro='" + AllTrim(cMsg) + ;
                      "' baixaTotal=" + cValToChar(jEst["baixa"]) + " transacaoAberta=" + cValToChar(InTransact()))

    If Empty(cMsg) .And. !jEst["baixa"]
        cMsg := "a baixa do título do fornecedor não foi confirmada no banco de dados."
    EndIf

    // Valor líquido efetivamente baixado: o FINA080 grava E2_VALLIQ na própria baixa
    If Empty(cMsg)
        SE2->(DbGoTo(nRecSE2))
        nValor := SE2->E2_VALLIQ
        If nValor <= 0
            cMsg := "valor líquido da baixa não identificado (E2_VALLIQ)."
        EndIf
    EndIf

    If Empty(cMsg)
        cMsg := GeraPagarBanco(nRecSE2, jCfg, aForn, nValor, cNumero)
        jEst := U_PXRSEstadoTitulo(nRecSE2)
        U_PXRSLog("INFO", "Antecipação " + AllTrim(cChave) + " - passo título do banco: erro='" + AllTrim(cMsg) + ;
                          "' recnoBanco=" + cValToChar(jEst["recbco"]) + " transacaoAberta=" + cValToChar(InTransact()))
        If Empty(cMsg) .And. jEst["recbco"] == 0
            cMsg := "o título a pagar do banco não foi confirmado no banco de dados."
        EndIf
    EndIf

    If !Empty(cMsg)
        Return cMsg + CRLF + CompensaFalha(nRecSE2, cChave)
    EndIf

    cMsg := U_PXRSMarcaStatus(nRecSE2, RS_ANTECIPADO, dDataBase)
    If !Empty(cMsg)
        cMsg += " A baixa e o título do banco foram gravados; o título permanece Em processamento." + ;
                " Use a ação Conciliar da rotina Risco Sacado."
    EndIf
Return cMsg

/*/{Protheus.doc} CompensaFalha
Compensa uma antecipação interrompida e devolve o texto do resultado para a mensagem do usuário.
Protegida por Try/Catch própria porque também é chamada de dentro do Catch da antecipação, onde
uma nova exceção não seria capturada.
@type static function
@author bacoetrom
@since 28/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@param cChave, character, chave de origem (U_PXRSChaveOrigem)
@return character, texto descrevendo o resultado da compensação
/*/
Static Function CompensaFalha(nRecSE2 as numeric, cChave as character) as character
    Local cTexto := "" as character
    Local cMsg   := "" as character
    Local oErro  as object

    Try
        cMsg := DesfazAntecipa(nRecSE2, cChave)
    Catch oErro
        cMsg := "erro inesperado ao desfazer a antecipação: " + oErro:Description
    EndTry

    If Empty(cMsg)
        cTexto := "A antecipação foi desfeita: o título voltou para Disponível."
        U_PXRSLog("INFO", "Compensação concluída: " + AllTrim(cChave))
    Else
        cTexto := "ATENÇÃO: não foi possível desfazer a antecipação (" + AllTrim(cMsg) + ")." + ;
                  " O título permanece Em processamento - use a ação Conciliar da rotina Risco Sacado."
        U_PXRSLog("ERROR", "Compensação falhou: " + AllTrim(cChave) + " - " + cMsg)
    EndIf
Return cTexto

/*/{Protheus.doc} PXRSValidaEstorno
Valida se o título a pagar do banco pode ser excluído no estorno da antecipação.
@type user function
@author bacoetrom
@since 19/10/2026
@param nRecBco, numeric, R_E_C_N_O_ do título a pagar do banco
@return character, mensagem de erro ou vazio quando permitido
/*/
User Function PXRSValidaEstorno(nRecBco as numeric) as character
    Local aArea    := GetArea() as array
    Local aAreaSE2 := SE2->(GetArea()) as array
    Local cMsg     := "" as character
    Local cTitulo  := "" as character

    SE2->(DbGoTo(nRecBco))
    cTitulo := AllTrim(SE2->(E2_PREFIXO + "/" + E2_NUM + "/" + E2_PARCELA))
    If !Empty(SE2->E2_BAIXA) .Or. SE2->E2_SALDO < SE2->E2_VALOR - RS_TOLERANCIA
        cMsg := "o título a pagar do banco " + cTitulo + " já possui baixa. Cancele a baixa antes de estornar."
    ElseIf !Empty(SE2->E2_NUMBOR)
        cMsg := "o título a pagar do banco " + cTitulo + " está no borderô " + AllTrim(SE2->E2_NUMBOR) + ". Retire-o do borderô antes de estornar."
    EndIf

    RestArea(aAreaSE2)
    RestArea(aArea)
Return cMsg

/*/{Protheus.doc} PXRSEstornaAntecipacao
Estorna a antecipação (2 -> 1), em passos conferidos no banco de dados:
  1. grava a situação 9 (Em processamento);
  2. exclui o título a pagar do banco (ExecAuto FINA050 opção 5);
  3. cancela a baixa do título do fornecedor (ExecAuto FINA080 opção 5);
  4. volta a situação para 1 (Disponível).
Pelos mesmos motivos da antecipação, não há transação envolvendo os ExecAuto. Quando um passo
falha, o título permanece na situação 9 e é resolvido pela ação Conciliar. Não usa interface.
@type user function
@author bacoetrom
@since 19/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@return character, mensagem de erro ou vazio quando estornado com sucesso
/*/
User Function PXRSEstornaAntecipacao(nRecSE2 as numeric) as character
    Local aArea    := GetArea() as array
    Local aAreaSE2 := SE2->(GetArea()) as array
    Local cMsg     := "" as character
    Local cChave   := "" as character
    Local jEst     as json
    Local oErro    as object

    jEst   := U_PXRSEstadoTitulo(nRecSE2)
    cChave := jEst["chave"]

    If InTransact()
        cMsg := "estorno chamado dentro de uma transação aberta. Execute a ação pela rotina Risco Sacado (PXFINA37)."
        U_PXRSLog("ERROR", "Estorno abortado (transação aberta): " + AllTrim(cChave))
    ElseIf SE2->(Eof()) .Or. SE2->E2_XRISCO <> RS_RISCO_SIM .Or. SE2->E2_XSTRIC <> RS_ANTECIPADO
        cMsg := "título não está Antecipado no risco sacado."
    ElseIf SE2->E2_FILIAL <> xFilial("SE2")
        cMsg := "título de outra filial. Acesse a filial " + AllTrim(SE2->E2_FILIAL) + " para estornar."
    ElseIf jEst["recbco"] > 0
        cMsg := U_PXRSValidaEstorno(jEst["recbco"])
    EndIf

    If Empty(cMsg)
        Try
            cMsg := U_PXRSMarcaStatus(nRecSE2, RS_PROCESSANDO, Nil)
            If Empty(cMsg)
                cMsg := DesfazAntecipa(nRecSE2, cChave)
            EndIf
        Catch oErro
            cMsg := "erro inesperado no estorno da antecipação: " + oErro:Description
            U_PXRSLog("ERROR", "Estorno " + AllTrim(cChave) + " - " + cMsg)
        EndTry
    EndIf

    If Empty(cMsg)
        U_PXRSLog("INFO", "Antecipação estornada: " + AllTrim(cChave) + " - usuário " + AllTrim(UsrRetName(RetCodUsr())))
    Else
        jEst := U_PXRSEstadoTitulo(nRecSE2)
        If jEst["status"] == RS_PROCESSANDO
            cMsg += CRLF + "O título permanece Em processamento - use a ação Conciliar da rotina Risco Sacado."
        EndIf
        U_PXRSLog("WARN", "Estorno da antecipação rejeitado: " + AllTrim(cChave) + " - " + cMsg)
    EndIf

    RestArea(aAreaSE2)
    RestArea(aArea)
Return cMsg

/*/{Protheus.doc} PXRSConcilia
Resolve um título cuja antecipação ficou incompleta, decidindo pelo estado real dos registros
(baixa do fornecedor e existência do título a pagar do banco):
  - baixa presente e título do banco presente -> grava a situação 2 (Antecipado);
  - baixa presente e título do banco ausente  -> gera o título do banco e grava a situação 2;
  - demais casos                              -> desfaz o que existir e grava a situação 1.
Idempotente: executar de novo em um título já consistente não altera nada.
Atende também os títulos que ficaram inconsistentes antes da correção da rotina.
@type user function
@author bacoetrom
@since 28/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@return character, mensagem de erro ou vazio quando conciliado
/*/
User Function PXRSConcilia(nRecSE2 as numeric, jCfg as json) as character
    Local aArea    := GetArea() as array
    Local aAreaSE2 := SE2->(GetArea()) as array
    Local cMsg     := "" as character
    Local cChave   := "" as character
    Local dDtAnt   := CtoD("") as date
    Local jEst     as json
    Local oErro    as object

    jEst   := U_PXRSEstadoTitulo(nRecSE2)
    cChave := jEst["chave"]

    If InTransact()
        cMsg := "conciliação chamada dentro de uma transação aberta. Execute a ação pela rotina Risco Sacado (PXFINA37)."
        U_PXRSLog("ERROR", "Conciliação abortada (transação aberta): " + AllTrim(cChave))
    ElseIf SE2->(Eof()) .Or. SE2->E2_XRISCO <> RS_RISCO_SIM
        cMsg := "título não está em risco sacado."
    ElseIf !Empty(SE2->E2_XORIRS)
        cMsg := "título a pagar do banco não é conciliado; selecione o título do fornecedor."
    ElseIf jEst["status"] == RS_EM_ABERTO
        cMsg := "título está Em aberto; a conciliação trata apenas Disponível, Antecipado e Em processamento."
    ElseIf SE2->E2_FILIAL <> xFilial("SE2")
        cMsg := "título de outra filial. Acesse a filial " + AllTrim(SE2->E2_FILIAL) + " para conciliar."
    EndIf

    If Empty(cMsg)
        U_PXRSLog("INFO", "Conciliação - estado de " + AllTrim(cChave) + ": situação '" + jEst["status"] + ;
                          "' baixaTotal=" + cValToChar(jEst["baixa"]) + " movBaixa=" + cValToChar(jEst["movbaixa"]) + ;
                          " recnoBanco=" + cValToChar(jEst["recbco"]))
        Try
            If jEst["baixa"] .And. jEst["recbco"] > 0
                SE2->(DbGoTo(nRecSE2))
                dDtAnt := SE2->E2_XDTANT
                If Empty(dDtAnt)
                    dDtAnt := dDataBase
                EndIf
                cMsg := U_PXRSMarcaStatus(nRecSE2, RS_ANTECIPADO, dDtAnt)
            ElseIf jEst["baixa"]
                cMsg := ConcluiAntecipa(nRecSE2, jCfg, cChave)
            Else
                cMsg := DesfazAntecipa(nRecSE2, cChave)
            EndIf
        Catch oErro
            cMsg := "erro inesperado na conciliação: " + oErro:Description
            U_PXRSLog("ERROR", "Conciliação " + AllTrim(cChave) + " - " + cMsg)
        EndTry
    EndIf

    If Empty(cMsg)
        U_PXRSLog("INFO", "Conciliado: " + AllTrim(cChave) + " - usuário " + AllTrim(UsrRetName(RetCodUsr())))
    Else
        U_PXRSLog("WARN", "Conciliação não concluída: " + AllTrim(cChave) + " - " + cMsg)
    EndIf

    RestArea(aAreaSE2)
    RestArea(aArea)
Return cMsg

/*/{Protheus.doc} DesfazAntecipa
Desfaz a antecipação do título: exclui o título a pagar do banco (quando existir), cancela a
baixa do fornecedor (quando houver movimento de baixa) e grava a situação 1 (Disponível).
Cada passo é conferido no banco de dados antes do seguinte.
@type static function
@author bacoetrom
@since 28/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@param cChave, character, chave de origem (U_PXRSChaveOrigem)
@return character, mensagem de erro ou vazio quando desfeito
/*/
Static Function DesfazAntecipa(nRecSE2 as numeric, cChave as character) as character
    Local cMsg := "" as character
    Local jEst as json

    jEst := U_PXRSEstadoTitulo(nRecSE2)

    If jEst["recbco"] > 0
        cMsg := U_PXRSValidaEstorno(jEst["recbco"])

        If Empty(cMsg)
            cMsg := ExcluiPagarBanco(jEst["recbco"])
            jEst := U_PXRSEstadoTitulo(nRecSE2)
            If Empty(cMsg) .And. jEst["recbco"] > 0
                cMsg := "a exclusão do título a pagar do banco não foi confirmada no banco de dados."
            EndIf
        EndIf
    EndIf

    If Empty(cMsg) .And. jEst["movbaixa"]
        cMsg := CancelaBaixaOriginal(nRecSE2)
        jEst := U_PXRSEstadoTitulo(nRecSE2)
        U_PXRSLog("INFO", "Desfazer antecipação " + AllTrim(cChave) + " - cancelamento da baixa: erro='" + ;
                          AllTrim(cMsg) + "' movBaixa=" + cValToChar(jEst["movbaixa"]))
        If Empty(cMsg) .And. jEst["movbaixa"]
            cMsg := "o cancelamento da baixa do título do fornecedor não foi confirmado no banco de dados."
        EndIf
    EndIf

    If Empty(cMsg)
        cMsg := U_PXRSMarcaStatus(nRecSE2, RS_DISPONIVEL, Nil)
    EndIf

    If Empty(cMsg)
        U_PXRSLog("INFO", "Antecipação desfeita: " + AllTrim(cChave))
    EndIf
Return cMsg

/*/{Protheus.doc} ConcluiAntecipa
Conclui uma antecipação que já tem a baixa gravada e está sem o título a pagar do banco: gera o
título do banco pelo valor líquido da baixa (E2_VALLIQ) e grava a situação 2 (Antecipado).
@type static function
@author bacoetrom
@since 28/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@param cChave, character, chave de origem (U_PXRSChaveOrigem)
@return character, mensagem de erro ou vazio quando concluído
/*/
Static Function ConcluiAntecipa(nRecSE2 as numeric, jCfg as json, cChave as character) as character
    Local aForn    := {"", ""} as array
    Local cMsg     := "" as character
    Local cLock    := "" as character
    Local cNomLock := "" as character
    Local cNumero  := "" as character
    Local cFilAux  := "" as character
    Local cLoteAux := "" as character
    Local cBcoAux  := "" as character
    Local nValor   := 0 as numeric
    Local jEst     as json

    SE2->(DbGoTo(nRecSE2))
    cFilAux  := SE2->E2_FILIAL
    cLoteAux := SE2->E2_XLOTRS
    cBcoAux  := SE2->E2_XBANCO
    nValor   := SE2->E2_VALLIQ

    cMsg := U_PXRSValidaConfig(jCfg, cFilAux)

    If Empty(cMsg)
        aForn := U_PXRSFornBanco(cFilAux, cBcoAux)
        If Empty(aForn[1])
            cMsg := "banco '" + AllTrim(cBcoAux) + "' sem fornecedor (A6_XFORN/A6_XLOJA) informado."
        EndIf
    EndIf

    If Empty(cMsg) .And. nValor <= 0
        cMsg := "valor líquido da baixa não identificado (E2_VALLIQ)."
    EndIf

    If Empty(cMsg)
        cNomLock := "PXRS" + AllTrim(cFilAux) + AllTrim(cLoteAux)
        If LockByName(cNomLock, .T., .F.)
            cLock := cNomLock
        Else
            cMsg := "lote " + AllTrim(cLoteAux) + " em processamento por outro usuário. Tente novamente."
        EndIf
    EndIf

    If Empty(cMsg)
        cNumero := ProximoNumero(cFilAux, cLoteAux, jCfg, aForn)
        If Empty(cNumero)
            cMsg := "não foi possível gerar o número do título do banco para o lote " + AllTrim(cLoteAux) + ;
                    " (tamanho de E2_NUM insuficiente ou sequência esgotada)."
        EndIf
    EndIf

    If Empty(cMsg)
        cMsg := GeraPagarBanco(nRecSE2, jCfg, aForn, nValor, cNumero)
        jEst := U_PXRSEstadoTitulo(nRecSE2)
        U_PXRSLog("INFO", "Conciliação " + AllTrim(cChave) + " - geração do título do banco: erro='" + ;
                          AllTrim(cMsg) + "' recnoBanco=" + cValToChar(jEst["recbco"]))
        If Empty(cMsg) .And. jEst["recbco"] == 0
            cMsg := "o título a pagar do banco não foi confirmado no banco de dados."
        EndIf
    EndIf

    If !Empty(cLock)
        UnLockByName(cLock, .T., .F.)
    EndIf

    If Empty(cMsg)
        cMsg := U_PXRSMarcaStatus(nRecSE2, RS_ANTECIPADO, dDataBase)
    EndIf
Return cMsg

/*/{Protheus.doc} PXRSEmRotina
Indica se a execução atual partiu da rotina de Risco Sacado (antecipação, estorno ou
conciliação), liberando os pontos de entrada de bloqueio para os ExecAuto da própria rotina.
@type user function
@author bacoetrom
@since 19/10/2026
@return logical, .T. quando chamado pela rotina
/*/
User Function PXRSEmRotina() as logical
Return FwIsInCallStack("U_PXRSANTECIPA") .Or. FwIsInCallStack("U_PXRSESTORNAANTECIPACAO") .Or. ;
       FwIsInCallStack("U_PXRSCONCILIA")

/*/{Protheus.doc} PXRSBloqueia
Regra única de bloqueio de movimentação fora da rotina de Risco Sacado.
Usada por todos os pontos de entrada. SE2 deve estar posicionado no título.
  - Título do fornecedor em situação 1 (Disponível), 2 (Antecipado) ou 9 (Em processamento):
    bloqueia qualquer movimentação.
  - Título a pagar do banco (E2_XORIRS preenchido): bloqueia alteração e exclusão.
@type user function
@author bacoetrom
@since 19/10/2026
@param cOperacao, character, BAIXA, ESTORNO, BORDERO, ALTERACAO ou EXCLUSAO
@return character, mensagem de bloqueio ou vazio quando permitido
/*/
User Function PXRSBloqueia(cOperacao as character) as character
    Local cMsg    := "" as character
    Local cTitulo := "" as character

    If SE2->(Eof()) .Or. !U_PXRSDicionario() .Or. U_PXRSEmRotina()
        Return cMsg
    EndIf

    cTitulo := AllTrim(SE2->(E2_PREFIXO + "/" + E2_NUM + "/" + E2_PARCELA + "/" + E2_TIPO))

    If SE2->E2_XRISCO == RS_RISCO_SIM .And. ;
       (SE2->E2_XSTRIC == RS_DISPONIVEL .Or. SE2->E2_XSTRIC == RS_ANTECIPADO .Or. SE2->E2_XSTRIC == RS_PROCESSANDO)
        cMsg := "Título " + cTitulo + " está em Risco Sacado - " + ;
                U_PXRSDescSituacao(SE2->E2_XRISCO, SE2->E2_XSTRIC) + " (lote " + AllTrim(SE2->E2_XLOTRS) + "). " + ;
                "Operação '" + cOperacao + "' permitida somente pela rotina Risco Sacado (PXFINA37)."
    ElseIf !Empty(SE2->E2_XORIRS) .And. (cOperacao == "ALTERACAO" .Or. cOperacao == "EXCLUSAO")
        cMsg := "Título " + cTitulo + " foi gerado pelo Risco Sacado (antecipação do título " + AllTrim(SE2->E2_XORIRS) + "). " + ;
                "Para desfazer, use 'Estornar Situação' na rotina Risco Sacado (PXFINA37)."
    EndIf

    If !Empty(cMsg)
        U_PXRSLog("WARN", "Bloqueio " + cOperacao + " (" + FunName() + "): " + cMsg)
    EndIf
Return cMsg

/*/{Protheus.doc} PXRSLog
Registra mensagem no log do servidor (FWLogMsg).
@type user function
@author bacoetrom
@since 19/10/2026
@param cNivel, character, severidade (INFO, WARN, ERROR)
@param cMsg, character, mensagem
@return logical, sempre .T.
/*/
User Function PXRSLog(cNivel as character, cMsg as character) as logical
    FWLogMsg(cNivel, , "RISCOSACADO", "PXFINA37", , "01", cMsg, 0, 0, {})
Return .T.

/*/{Protheus.doc} PXRSLogAtivo
Indica se o log de diagnóstico dos pontos de entrada está ligado (MV_XRSLOG).
@type user function
@author bacoetrom
@since 19/10/2026
@return logical, .T. quando o diagnóstico está ativo
/*/
User Function PXRSLogAtivo() as logical
Return SuperGetMV("MV_XRSLOG", .F., .F.)

/*/{Protheus.doc} BaixaOriginal
Baixa total do título do fornecedor pela antecipação (ExecAuto FINA080 - opção 3).
Motivo MV_XRSMOT sem movimentação bancária: não informa banco/agência/conta.
O valor não é informado (AUTVLRPG): o padrão baixa o saldo e calcula as retenções na baixa,
gravando o líquido pago em E2_VALLIQ.
O retorno não é conclusivo por si: quem chama confere o estado por U_PXRSEstadoTitulo.
@type static function
@author bacoetrom
@since 19/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@return character, mensagem de erro ou vazio quando baixado
/*/
Static Function BaixaOriginal(nRecSE2 as numeric, jCfg as json) as character
    Local aBaixa    := {} as array
    Local cMsg      := "" as character
    Local cHist     := "" as character
    Local oModelBkp as object
    Private lMsErroAuto    := .F.
    Private lAutoErrNoFile := .T.

    SE2->(DbGoTo(nRecSE2))
    cHist := "RISCO SACADO ANTECIPADO LOTE " + AllTrim(SE2->E2_XLOTRS) + " BCO " + AllTrim(SE2->E2_XBANCO)

    aAdd(aBaixa, {"E2_FILIAL"   , SE2->E2_FILIAL , Nil})
    aAdd(aBaixa, {"E2_PREFIXO"  , SE2->E2_PREFIXO, Nil})
    aAdd(aBaixa, {"E2_NUM"      , SE2->E2_NUM    , Nil})
    aAdd(aBaixa, {"E2_PARCELA"  , SE2->E2_PARCELA, Nil})
    aAdd(aBaixa, {"E2_TIPO"     , SE2->E2_TIPO   , Nil})
    aAdd(aBaixa, {"E2_FORNECE"  , SE2->E2_FORNECE, Nil})
    aAdd(aBaixa, {"E2_LOJA"     , SE2->E2_LOJA   , Nil})
    aAdd(aBaixa, {"AUTMOTBX"    , jCfg["mot"]    , Nil})
    aAdd(aBaixa, {"AUTDTBAIXA"  , dDataBase      , Nil})
    aAdd(aBaixa, {"AUTDTCREDITO", dDataBase      , Nil})
    aAdd(aBaixa, {"AUTHIST"     , cHist          , Nil})

    oModelBkp := FWModelActive()
    // FINA080(xAutoCab, nOpc, lNoMBrowse, nOpBaixa, lExibeLanc, lOnline): lExibeLanc .F. evita a tela contábil
    MsExecAuto({|a, b, c, d, e| FINA080(a, b, c, d, e)}, aBaixa, 3, Nil, Nil, .F.)
    If ValType(oModelBkp) == "O"
        FWModelActive(oModelBkp)
    EndIf

    If lMsErroAuto
        RollBackSX8()
        cMsg := "falha na baixa do título do fornecedor." + CRLF + MontaErroAuto()
    Else
        ConfirmSX8()
    EndIf
Return cMsg

/*/{Protheus.doc} CancelaBaixaOriginal
Cancela a baixa da antecipação do título do fornecedor (ExecAuto FINA080 - opção 5).
O título é elegível somente sem baixa anterior, então a única baixa ativa é a da antecipação.
O retorno não é conclusivo por si: quem chama confere o estado por U_PXRSEstadoTitulo.
@type static function
@author bacoetrom
@since 19/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@return character, mensagem de erro ou vazio quando cancelado
/*/
Static Function CancelaBaixaOriginal(nRecSE2 as numeric) as character
    Local aBaixa    := {} as array
    Local cMsg      := "" as character
    Local oModelBkp as object
    Private lMsErroAuto    := .F.
    Private lAutoErrNoFile := .T.

    SE2->(DbGoTo(nRecSE2))
    aAdd(aBaixa, {"E2_FILIAL" , SE2->E2_FILIAL , Nil})
    aAdd(aBaixa, {"E2_PREFIXO", SE2->E2_PREFIXO, Nil})
    aAdd(aBaixa, {"E2_NUM"    , SE2->E2_NUM    , Nil})
    aAdd(aBaixa, {"E2_PARCELA", SE2->E2_PARCELA, Nil})
    aAdd(aBaixa, {"E2_TIPO"   , SE2->E2_TIPO   , Nil})
    aAdd(aBaixa, {"E2_FORNECE", SE2->E2_FORNECE, Nil})
    aAdd(aBaixa, {"E2_LOJA"   , SE2->E2_LOJA   , Nil})

    oModelBkp := FWModelActive()
    MsExecAuto({|a, b, c, d, e| FINA080(a, b, c, d, e)}, aBaixa, 5, Nil, Nil, .F.)
    If ValType(oModelBkp) == "O"
        FWModelActive(oModelBkp)
    EndIf

    If lMsErroAuto
        RollBackSX8()
        cMsg := "falha no cancelamento da baixa do título do fornecedor." + CRLF + MontaErroAuto()
    Else
        ConfirmSX8()
    EndIf
Return cMsg

/*/{Protheus.doc} GeraPagarBanco
Inclui o título a pagar do banco (ExecAuto FINA050 - opção 3).
Fornecedor A6_XFORN/A6_XLOJA, prefixo MV_XRSPRF, tipo MV_XRSTIP, natureza MV_XRSNAT,
emissão = data da antecipação, vencimento = do título original.
O número é gerado por ProximoNumero antes da baixa e recebido pronto, para que uma falha de
numeração não deixe o título do fornecedor baixado sem contrapartida.
@type static function
@author bacoetrom
@since 19/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@param aForn, array, {fornecedor, loja} do banco
@param nValor, numeric, valor líquido baixado do título original
@param cNumero, character, número já reservado para o título do banco (E2_NUM)
@return character, mensagem de erro ou vazio quando gerado
/*/
Static Function GeraPagarBanco(nRecSE2 as numeric, jCfg as json, aForn as array, nValor as numeric, cNumero as character) as character
    Local aTitulo   := {} as array
    Local aCopia    := {} as array
    Local cMsg      := "" as character
    Local cHist     := "" as character
    Local cChave    := "" as character
    Local nI        := 0 as numeric
    Local oModelBkp as object
    Private lMsErroAuto    := .F.
    Private lAutoErrNoFile := .T.

    SE2->(DbGoTo(nRecSE2))
    cChave := U_PXRSChaveOrigem()

    If Empty(cNumero)
        Return "número do título a pagar do banco não informado."
    EndIf

    cHist := "R.SACADO " + AllTrim(SE2->E2_FORNECE) + "/" + AllTrim(SE2->E2_LOJA) + " " + ;
             AllTrim(SE2->(E2_PREFIXO + "/" + E2_NUM + "/" + E2_PARCELA))

    aAdd(aTitulo, {"E2_PREFIXO", jCfg["prf"]                          , Nil})
    aAdd(aTitulo, {"E2_NUM"    , cNumero                              , Nil})
    aAdd(aTitulo, {"E2_PARCELA", Space(TamSX3("E2_PARCELA")[1])       , Nil})
    aAdd(aTitulo, {"E2_TIPO"   , jCfg["tip"]                          , Nil})
    aAdd(aTitulo, {"E2_NATUREZ", jCfg["nat"]                          , Nil})
    aAdd(aTitulo, {"E2_FORNECE", aForn[1]                             , Nil})
    aAdd(aTitulo, {"E2_LOJA"   , aForn[2]                             , Nil})
    aAdd(aTitulo, {"E2_EMISSAO", dDataBase                            , Nil})
    aAdd(aTitulo, {"E2_VENCTO" , SE2->E2_VENCTO                       , Nil})
    aAdd(aTitulo, {"E2_VENCREA", SE2->E2_VENCREA                      , Nil})
    aAdd(aTitulo, {"E2_VALOR"  , nValor                               , Nil})
    aAdd(aTitulo, {"E2_MOEDA"  , SE2->E2_MOEDA                        , Nil})
    aAdd(aTitulo, {"E2_HIST"   , Left(cHist, TamSX3("E2_HIST")[1])    , Nil})
    aAdd(aTitulo, {"E2_XORIRS" , cChave                               , Nil})

    // Entidades contábeis do título original (somente quando preenchidas)
    aCopia := {"E2_TXMOEDA", "E2_CCD", "E2_CCC", "E2_ITEMD", "E2_ITEMC", "E2_CLVLDB", "E2_CLVLCR"}
    For nI := 1 To Len(aCopia)
        If SE2->(FieldPos(aCopia[nI])) > 0 .And. !Empty(SE2->(FieldGet(FieldPos(aCopia[nI]))))
            aAdd(aTitulo, {aCopia[nI], SE2->(FieldGet(FieldPos(aCopia[nI]))), Nil})
        EndIf
    Next nI

    oModelBkp := FWModelActive()
    // FINA050(aRotAuto, nOpcion, nOpcAuto, bExecuta, aDadosBco, lExibeLanc)
    MsExecAuto({|a, b, c, d, e, f| FinA050(a, b, c, d, e, f)}, aTitulo, Nil, 3, Nil, Nil, .F.)
    If ValType(oModelBkp) == "O"
        FWModelActive(oModelBkp)
    EndIf

    If lMsErroAuto
        RollBackSX8()
        cMsg := "falha ao gerar o título a pagar do banco." + CRLF + MontaErroAuto()
    Else
        ConfirmSX8()
        U_PXRSLog("INFO", "Título a pagar do banco gerado: " + AllTrim(jCfg["prf"]) + "/" + AllTrim(cNumero) + ;
                          " fornecedor " + AllTrim(aForn[1]) + "/" + AllTrim(aForn[2]) + " - origem " + AllTrim(cChave))
    EndIf
Return cMsg

/*/{Protheus.doc} ExcluiPagarBanco
Exclui o título a pagar do banco (ExecAuto FINA050 - opção 5).
O retorno não é conclusivo por si: quem chama confere o estado por U_PXRSEstadoTitulo.
@type static function
@author bacoetrom
@since 19/10/2026
@param nRecBco, numeric, R_E_C_N_O_ do título a pagar do banco
@return character, mensagem de erro ou vazio quando excluído
/*/
Static Function ExcluiPagarBanco(nRecBco as numeric) as character
    Local aTitulo   := {} as array
    Local cMsg      := "" as character
    Local cChave    := "" as character
    Local oModelBkp as object
    Private lMsErroAuto    := .F.
    Private lAutoErrNoFile := .T.

    SE2->(DbGoTo(nRecBco))
    cChave := U_PXRSChaveOrigem()

    aAdd(aTitulo, {"E2_FILIAL" , SE2->E2_FILIAL , Nil})
    aAdd(aTitulo, {"E2_PREFIXO", SE2->E2_PREFIXO, Nil})
    aAdd(aTitulo, {"E2_NUM"    , SE2->E2_NUM    , Nil})
    aAdd(aTitulo, {"E2_PARCELA", SE2->E2_PARCELA, Nil})
    aAdd(aTitulo, {"E2_TIPO"   , SE2->E2_TIPO   , Nil})
    aAdd(aTitulo, {"E2_FORNECE", SE2->E2_FORNECE, Nil})
    aAdd(aTitulo, {"E2_LOJA"   , SE2->E2_LOJA   , Nil})

    oModelBkp := FWModelActive()
    MsExecAuto({|a, b, c, d, e, f| FinA050(a, b, c, d, e, f)}, aTitulo, Nil, 5, Nil, Nil, .F.)
    If ValType(oModelBkp) == "O"
        FWModelActive(oModelBkp)
    EndIf

    If lMsErroAuto
        RollBackSX8()
        cMsg := "falha ao excluir o título a pagar do banco " + AllTrim(cChave) + "." + CRLF + MontaErroAuto()
    Else
        ConfirmSX8()
        U_PXRSLog("INFO", "Título a pagar do banco excluído: " + AllTrim(cChave))
    EndIf
Return cMsg

/*/{Protheus.doc} ProximoNumero
Gera o número do título do banco: lote (E2_XLOTRS) + sequência com zeros, único para
filial + prefixo + tipo + fornecedor do banco. Chamado sob LockByName do lote.
@type static function
@author bacoetrom
@since 19/10/2026
@param cFilTit, character, filial do título
@param cLote, character, lote do risco sacado
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@param aForn, array, {fornecedor, loja} do banco
@return character, número (E2_NUM) ou vazio quando não for possível gerar
/*/
Static Function ProximoNumero(cFilTit as character, cLote as character, jCfg as json, aForn as array) as character
    Local cNumero    := "" as character
    Local cQuery     := "" as character
    Local cLoteAux   := "" as character
    Local nTamNum    := TamSX3("E2_NUM")[1] as numeric
    Local nTamSeq    := 0 as numeric
    Local nSeq       := 0 as numeric
    Local xRet       as variant
    Local oStatement as object

    cLoteAux := AllTrim(cLote)
    nTamSeq  := nTamNum - Len(cLoteAux)
    If nTamSeq < RS_TAM_SEQ
        Return cNumero
    EndIf

    cQuery := "SELECT MAX(SE2.E2_NUM) NUMMAX "
    cQuery += "  FROM " + RetSqlName("SE2") + " SE2 "
    cQuery += " WHERE SE2.D_E_L_E_T_ = ? "
    cQuery += "   AND SE2.E2_FILIAL = ? "
    cQuery += "   AND SE2.E2_PREFIXO = ? "
    cQuery += "   AND SE2.E2_TIPO = ? "
    cQuery += "   AND SE2.E2_FORNECE = ? "
    cQuery += "   AND SE2.E2_LOJA = ? "
    cQuery += "   AND SE2.E2_NUM LIKE ? "

    oStatement := FWExecStatement():New(ChangeQuery(cQuery))
    oStatement:SetString(1, " ")
    oStatement:SetString(2, xFilial("SE2", cFilTit))
    oStatement:SetString(3, jCfg["prf"])
    oStatement:SetString(4, jCfg["tip"])
    oStatement:SetString(5, aForn[1])
    oStatement:SetString(6, aForn[2])
    oStatement:SetString(7, cLoteAux + "%")
    xRet := oStatement:ExecScalar("NUMMAX")
    oStatement:Destroy()
    oStatement := Nil

    If ValType(xRet) == "C" .And. !Empty(xRet)
        nSeq := Val(Substr(AllTrim(xRet), Len(cLoteAux) + 1))
    EndIf
    nSeq++

    If nSeq < 10 ^ nTamSeq
        cNumero := cLoteAux + StrZero(nSeq, nTamSeq)
    EndIf
Return cNumero

/*/{Protheus.doc} MontaErroAuto
Converte o log da rotina automática (GetAutoGRLog) em texto.
@type static function
@author bacoetrom
@since 19/10/2026
@return character, mensagens de erro concatenadas
/*/
Static Function MontaErroAuto() as character
    Local aErros := GetAutoGRLog() as array
    Local cTexto := "" as character
    Local nI     := 0 as numeric

    For nI := 1 To Len(aErros)
        cTexto += AllTrim(aErros[nI]) + CRLF
    Next nI
Return cTexto

/*/{Protheus.doc} PXRSMarcaStatus
Grava a situação do risco sacado (E2_XSTRIC) e a data da antecipação (E2_XDTANT) do título.
Transação curta, somente na SE2, sem ExecAuto e sem interface (CA1002).
@type user function
@author bacoetrom
@since 28/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título
@param cStatus, character, situação a gravar (RS_DISPONIVEL, RS_ANTECIPADO, RS_EM_ABERTO ou RS_PROCESSANDO)
@param xDtAnt, variant, data da antecipação; quando não for data, grava data vazia
@return character, mensagem de erro ou vazio quando gravado
/*/
User Function PXRSMarcaStatus(nRecSE2 as numeric, cStatus as character, xDtAnt as variant) as character
    Local cMsg   := "" as character
    Local dDtAnt := CtoD("") as date
    Local oErro  as object

    If ValType(xDtAnt) == "D"
        dDtAnt := xDtAnt
    EndIf

    Try
        SE2->(DbGoTo(nRecSE2))
        If SE2->(Eof())
            cMsg := "título não localizado para gravar a situação do risco sacado."
        Else
            Begin Transaction
                RecLock("SE2", .F.)
                SE2->E2_XSTRIC := cStatus
                SE2->E2_XDTANT := dDtAnt
                SE2->(MsUnlock())
            End Transaction
        EndIf
    Catch oErro
        cMsg := "falha ao gravar a situação '" + cStatus + "' do risco sacado: " + oErro:Description
        U_PXRSLog("ERROR", cMsg)
    EndTry
Return cMsg

/*/{Protheus.doc} PXRSEstadoTitulo
Estado real do título de risco sacado no banco de dados. Reposiciona a SE2 no registro e relê
o buffer (DbSkip(0)), porque os ExecAuto gravam pelo próprio workarea e o conteúdo carregado
antes da chamada fica desatualizado.
@type user function
@author bacoetrom
@since 28/10/2026
@param nRecSE2, numeric, R_E_C_N_O_ do título do fornecedor
@return json, estado do título:
  chave    = chave de origem (U_PXRSChaveOrigem)
  filial   = filial do título
  status   = conteúdo de E2_XSTRIC
  baixa    = .T. quando o título está totalmente baixado
  movbaixa = .T. quando existe qualquer movimento de baixa (total ou parcial)
  recbco   = R_E_C_N_O_ do título a pagar do banco da antecipação (0 quando não existe)
/*/
User Function PXRSEstadoTitulo(nRecSE2 as numeric) as json
    Local jEst := JsonObject():New() as json

    SE2->(DbGoTo(nRecSE2))
    SE2->(DbSkip(0))

    jEst["chave"]    := ""
    jEst["filial"]   := ""
    jEst["status"]   := ""
    jEst["baixa"]    := .F.
    jEst["movbaixa"] := .F.
    jEst["recbco"]   := 0

    If !SE2->(Eof())
        jEst["chave"]    := U_PXRSChaveOrigem()
        jEst["filial"]   := SE2->E2_FILIAL
        jEst["status"]   := SE2->E2_XSTRIC
        jEst["baixa"]    := SE2->E2_SALDO <= RS_TOLERANCIA .And. !Empty(SE2->E2_BAIXA)
        jEst["movbaixa"] := SE2->E2_SALDO < SE2->E2_VALOR - RS_TOLERANCIA .Or. !Empty(SE2->E2_BAIXA)
        jEst["recbco"]   := U_PXRSBuscaPagar(jEst["filial"], jEst["chave"])
    EndIf
Return jEst
