#include "tlpp-core.th"
#include "totvs.ch"

#define RS_PARAM_LOAD "PXFINA37"
#define RS_TITULO     "Risco Sacado"
#define RS_RISCO_SIM   "S"
#define RS_RISCO_NAO   "N"
#define RS_DISPONIVEL  "1"
#define RS_ANTECIPADO  "2"
#define RS_EM_ABERTO   "3"
#define RS_PROCESSANDO "9"
#define RS_TOLERANCIA  0.0049
#define RS_MAX_LOG     40

// Posições do array de parâmetros (ParamBox)
#define PAR_FILDE     1
#define PAR_FILATE    2
#define PAR_VENCDE    3
#define PAR_VENCATE   4
#define PAR_FORDE     5
#define PAR_FORATE    6
#define PAR_NATDE     7
#define PAR_NATATE    8
#define PAR_LOTEDE    9
#define PAR_LOTEATE   10
#define PAR_SITUAC    11
#define PAR_BCORS     12

// Opções do parâmetro Situação (combo)
#define SIT_SEM_RISCO  1
#define SIT_DISPONIVEL 2
#define SIT_ANTECIPADO 3
#define SIT_EM_ABERTO  4
#define SIT_EM_RISCO   5
#define SIT_INCONSIST  6

// Posições do array de títulos marcados
#define MRK_RECNO     1
#define MRK_FILIAL    2
#define MRK_LOTE      3
#define MRK_RISCO     4

/*/{Protheus.doc} PXFINA37
Risco Sacado em Contas a Pagar - seleção de títulos a pagar (SE2) de fornecedores para
disponibilizar ao banco e controle do retorno (antecipado / em aberto).

Ações:
  - Disponibilizar    : títulos elegíveis (sem risco) -> situação 1, um lote por filial (E2_XLOTRS).
  - Antecipado        : 1 -> 2. Baixa o título do fornecedor (motivo MV_XRSMOT) e gera o título a pagar do banco.
  - Em aberto         : 1 -> 3. Título volta ao fluxo normal do Contas a Pagar.
  - Estornar Situação : 3 -> 1 (sem movimento após o envio) e 2 -> 1 (exclui título do banco e cancela a baixa).
  - Conciliar         : resolve o título cuja antecipação ficou incompleta (situação 9, Antecipado sem
                        baixa ou Disponível já baixado), concluindo ou desfazendo conforme o estado real.
  - Excluir Lote      : devolve os títulos do lote para "sem risco" (sem título antecipado e sem movimento).

Situações 1, 2 e 9 só podem ser movimentadas por esta rotina (PEs FINM020, FA080TIT, FA050UPD e F240TIT).

Parâmetros (ParamBox - última seleção salva por usuário, sem dependência de SX1):
  01 Filial de / 02 Filial até / 03 Vencimento real de / 04 Vencimento real até /
  05 Fornecedor de / 06 Fornecedor até / 07 Natureza de / 08 Natureza até / 09 Lote de / 10 Lote até /
  11 Situação (1=Sem risco;2=Disponível;3=Antecipado;4=Em aberto;5=Todos em risco;6=Inconsistentes) /
  12 Banco do risco sacado (SA6)

@type user function
@author bacoetrom
@since 19/10/2026
@return logical, .T. quando a tela foi aberta
/*/
User Function PXFINA37() as logical
    Local aPar := {} as array

    If !U_PXRSDicionario()
        FWAlertError("Campos do risco sacado não criados no dicionário (E2_X*, A6_XFORN, A6_XLOJA). " + ;
                     "Crie os campos conforme DICIONARIO.md do projeto.", RS_TITULO)
        Return .F.
    EndIf

    aPar := Parametros()
    If Empty(aPar)
        Return .F.
    EndIf
Return MontaTela(aPar)

/*/{Protheus.doc} Parametros
Exibe a tela de parâmetros (ParamBox) e devolve as respostas.
A situação (combo) é normalizada para numérico.
@type static function
@author bacoetrom
@since 19/10/2026
@return array, respostas na ordem das constantes PAR_* ou vazio quando cancelado
/*/
Static Function Parametros() as array
    Local aPergs    := {} as array
    Local aRet      := {} as array
    Local aSituacao := {} as array
    Local nTamFil   := TamSX3("E2_FILIAL")[1] as numeric
    Local nTamFor   := TamSX3("E2_FORNECE")[1] as numeric
    Local nTamNat   := TamSX3("E2_NATUREZ")[1] as numeric
    Local nTamLote  := TamSX3("E2_XLOTRS")[1] as numeric

    aSituacao := {"1-Sem risco", "2-Disponível", "3-Antecipado", "4-Em aberto", "5-Todos em risco", "6-Inconsistentes"}

    aAdd(aPergs, {1, "Filial de"            , Space(nTamFil)               , "@!", ".T.", "SM0", ".T.", 50, .F.})
    aAdd(aPergs, {1, "Filial até"           , Replicate("Z", nTamFil)      , "@!", ".T.", "SM0", ".T.", 50, .T.})
    aAdd(aPergs, {1, "Vencto real de"       , FirstDay(dDataBase)          , ""  , ".T.", ""   , ".T.", 50, .T.})
    aAdd(aPergs, {1, "Vencto real até"      , LastDay(dDataBase)           , ""  , ".T.", ""   , ".T.", 50, .T.})
    aAdd(aPergs, {1, "Fornecedor de"        , Space(nTamFor)               , "@!", ".T.", "SA2", ".T.", 50, .F.})
    aAdd(aPergs, {1, "Fornecedor até"       , Replicate("Z", nTamFor)      , "@!", ".T.", "SA2", ".T.", 50, .T.})
    aAdd(aPergs, {1, "Natureza de"          , Space(nTamNat)               , "@!", ".T.", "SED", ".T.", 50, .F.})
    aAdd(aPergs, {1, "Natureza até"         , Replicate("Z", nTamNat)      , "@!", ".T.", "SED", ".T.", 50, .T.})
    aAdd(aPergs, {1, "Lote de"              , Space(nTamLote)              , "@!", ".T.", ""   , ".T.", 40, .F.})
    aAdd(aPergs, {1, "Lote até"             , Replicate("Z", nTamLote)     , "@!", ".T.", ""   , ".T.", 40, .T.})
    aAdd(aPergs, {2, "Situação"             , aSituacao[1]                 , aSituacao, 90, ".T.", .T.})
    aAdd(aPergs, {1, "Banco do risco sacado", Space(TamSX3("A6_COD")[1])   , "@!", ".T.", "SA6", ".T.", 30, .F.})

    If !ParamBox(aPergs, "Risco Sacado - Parâmetros", @aRet, , , , , , , RS_PARAM_LOAD, .T., .T.)
        Return {}
    EndIf

    aRet[PAR_SITUAC] := OpcaoCombo(aRet[PAR_SITUAC])
Return aRet

/*/{Protheus.doc} OpcaoCombo
Converte o retorno do combo do ParamBox ("n-Descrição" ou posição numérica) em número.
@type static function
@author bacoetrom
@since 19/10/2026
@param xOpcao, variant, retorno do combo
@return numeric, número da opção
/*/
Static Function OpcaoCombo(xOpcao as variant) as numeric
    Local nOpcao := 1 as numeric

    If ValType(xOpcao) == "N"
        nOpcao := xOpcao
    ElseIf ValType(xOpcao) == "C" .And. !Empty(xOpcao)
        nOpcao := Val(Left(xOpcao, 1))
    EndIf
Return nOpcao

/*/{Protheus.doc} MontaTela
Cria a tabela temporária, carrega os títulos e exibe o FWMarkBrowse.
@type static function
@author bacoetrom
@since 19/10/2026
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, .T. quando a tela foi exibida
/*/
Static Function MontaTela(aPar as array) as logical
    Local aSize  := {} as array
    Local cAlias := "" as character
    Local oTmp   as object
    Local oDlg   as object
    Local oMark  as object

    oTmp   := CriaTemporaria()
    cAlias := oTmp:GetAlias()

    FWMsgRun(, {|| CarregaTitulos(cAlias, aPar)}, RS_TITULO, "Selecionando títulos...")
    (cAlias)->(DbGoTop())
    If (cAlias)->(Eof())
        FWAlertWarning("Nenhum título encontrado para os parâmetros informados.", RS_TITULO)
        oTmp:Delete()
        Return .F.
    EndIf

    aSize := FWGetDialogSize(oMainWnd)
    oDlg  := MsDialog():New(aSize[1], aSize[2], aSize[3], aSize[4], RS_TITULO,,,,,,,,, .T.,,,, .F.)

    oMark := FWMarkBrowse():New()
    oMark:SetOwner(oDlg)
    oMark:SetDescription("Risco Sacado - Títulos a Pagar")
    oMark:SetAlias(cAlias)
    oMark:SetFieldMark("TR_OK")
    oMark:SetTemporary(.T.)
    oMark:SetMenuDef("")
    oMark:DisableDetails()
    oMark:SetColumns(DefineColunas(cAlias))

    oMark:AddButton("Marcar Todos"     , {|| MarcaTodos(oMark, 1)})
    oMark:AddButton("Desmarcar Todos"  , {|| MarcaTodos(oMark, 2)})
    oMark:AddButton("Inverter Seleção" , {|| MarcaTodos(oMark, 3)})
    oMark:AddButton("Disponibilizar"   , {|| AcaoDisponibilizar(oMark, aPar)})
    oMark:AddButton("Antecipado"       , {|| AcaoAntecipado(oMark, aPar)})
    oMark:AddButton("Em aberto"        , {|| AcaoEmAberto(oMark, aPar)})
    oMark:AddButton("Estornar Situação", {|| AcaoEstorno(oMark, aPar)})
    oMark:AddButton("Conciliar"        , {|| AcaoConcilia(oMark, aPar)})
    oMark:AddButton("Excluir Lote"     , {|| AcaoExcluirLote(oMark, aPar)})
    oMark:AddButton("Sair"             , {|| oDlg:End()})

    // Clique no cabeçalho da coluna de marca inverte a seleção
    oMark:bAllMark := {|| MarcaTodos(oMark, 3)}

    oMark:Activate()
    oDlg:Activate()

    oMark:DeActivate()
    oTmp:Delete()
Return .T.

/*/{Protheus.doc} CriaTemporaria
Cria a tabela temporária do browse (FWTemporaryTable).
@type static function
@author bacoetrom
@since 19/10/2026
@return object, instância de FWTemporaryTable já criada
/*/
Static Function CriaTemporaria() as object
    Local aCampos := {} as array
    Local oTmp    as object

    aAdd(aCampos, {"TR_OK"    , "C", 2                        , 0})
    aAdd(aCampos, {"TR_FILIAL", "C", TamSX3("E2_FILIAL")[1]   , 0})
    aAdd(aCampos, {"TR_LOTE"  , "C", TamSX3("E2_XLOTRS")[1]   , 0})
    aAdd(aCampos, {"TR_RISCO" , "C", 1                        , 0})
    aAdd(aCampos, {"TR_STATUS", "C", 1                        , 0})
    aAdd(aCampos, {"TR_SITUAC", "C", 20                       , 0})
    aAdd(aCampos, {"TR_PREFIX", "C", TamSX3("E2_PREFIXO")[1]  , 0})
    aAdd(aCampos, {"TR_NUM"   , "C", TamSX3("E2_NUM")[1]      , 0})
    aAdd(aCampos, {"TR_PARCEL", "C", TamSX3("E2_PARCELA")[1]  , 0})
    aAdd(aCampos, {"TR_TIPO"  , "C", TamSX3("E2_TIPO")[1]     , 0})
    aAdd(aCampos, {"TR_FORNEC", "C", TamSX3("E2_FORNECE")[1]  , 0})
    aAdd(aCampos, {"TR_LOJA"  , "C", TamSX3("E2_LOJA")[1]     , 0})
    aAdd(aCampos, {"TR_NOMFOR", "C", TamSX3("E2_NOMFOR")[1]   , 0})
    aAdd(aCampos, {"TR_NATURE", "C", TamSX3("E2_NATUREZ")[1]  , 0})
    aAdd(aCampos, {"TR_EMISSA", "D", 8                        , 0})
    aAdd(aCampos, {"TR_VENCRE", "D", 8                        , 0})
    aAdd(aCampos, {"TR_VALOR" , "N", TamSX3("E2_VALOR")[1]    , TamSX3("E2_VALOR")[2]})
    aAdd(aCampos, {"TR_SALDO" , "N", TamSX3("E2_SALDO")[1]    , TamSX3("E2_SALDO")[2]})
    aAdd(aCampos, {"TR_NUMBOR", "C", TamSX3("E2_NUMBOR")[1]   , 0})
    aAdd(aCampos, {"TR_XBANCO", "C", TamSX3("E2_XBANCO")[1]   , 0})
    aAdd(aCampos, {"TR_DTANT" , "D", 8                        , 0})
    aAdd(aCampos, {"TR_RECSE2", "N", 12                       , 0})

    oTmp := FWTemporaryTable():New(GetNextAlias())
    oTmp:SetFields(aCampos)
    oTmp:AddIndex("01", {"TR_FILIAL", "TR_LOTE", "TR_PREFIX", "TR_NUM", "TR_PARCEL", "TR_TIPO"})
    oTmp:Create()
Return oTmp

/*/{Protheus.doc} CarregaTitulos
Seleciona os títulos a pagar conforme os parâmetros e grava na tabela temporária.
Não lista os títulos a pagar do banco gerados pelo risco sacado (E2_XORIRS preenchido).
@type static function
@author bacoetrom
@since 19/10/2026
@param cAlias, character, alias da tabela temporária
@param aPar, array, respostas dos parâmetros (ParamBox)
@return numeric, quantidade de títulos carregados
/*/
Static Function CarregaTitulos(cAlias as character, aPar as array) as numeric
    Local aBind      := {} as array
    Local cQuery     := "" as character
    Local cAliasQry  := "" as character
    Local nI         := 0 as numeric
    Local nQtd       := 0 as numeric
    Local nSituac    := 0 as numeric
    Local oStatement as object

    nSituac := aPar[PAR_SITUAC]

    cQuery := "SELECT SE2.E2_FILIAL, SE2.E2_PREFIXO, SE2.E2_NUM, SE2.E2_PARCELA, SE2.E2_TIPO, "
    cQuery += "       SE2.E2_FORNECE, SE2.E2_LOJA, SE2.E2_NOMFOR, SE2.E2_NATUREZ, SE2.E2_EMISSAO, SE2.E2_VENCREA, "
    cQuery += "       SE2.E2_VALOR, SE2.E2_SALDO, SE2.E2_NUMBOR, "
    cQuery += "       SE2.E2_XBANCO, SE2.E2_XLOTRS, SE2.E2_XRISCO, SE2.E2_XSTRIC, SE2.E2_XDTANT, SE2.R_E_C_N_O_ RECSE2 "
    cQuery += "  FROM " + RetSqlName("SE2") + " SE2 "
    cQuery += " WHERE SE2.D_E_L_E_T_ = ? "
    aAdd(aBind, " ")
    cQuery += "   AND SE2.E2_FILIAL BETWEEN ? AND ? "
    aAdd(aBind, aPar[PAR_FILDE])
    aAdd(aBind, aPar[PAR_FILATE])
    cQuery += "   AND SE2.E2_VENCREA BETWEEN ? AND ? "
    aAdd(aBind, DtoS(aPar[PAR_VENCDE]))
    aAdd(aBind, DtoS(aPar[PAR_VENCATE]))
    cQuery += "   AND SE2.E2_FORNECE BETWEEN ? AND ? "
    aAdd(aBind, aPar[PAR_FORDE])
    aAdd(aBind, aPar[PAR_FORATE])
    cQuery += "   AND SE2.E2_NATUREZ BETWEEN ? AND ? "
    aAdd(aBind, aPar[PAR_NATDE])
    aAdd(aBind, aPar[PAR_NATATE])
    cQuery += "   AND SE2.E2_XLOTRS BETWEEN ? AND ? "
    aAdd(aBind, aPar[PAR_LOTEDE])
    aAdd(aBind, aPar[PAR_LOTEATE])
    // Títulos do banco gerados pelo risco sacado não são listados
    cQuery += "   AND SE2.E2_XORIRS = ? "
    aAdd(aBind, Space(TamSX3("E2_XORIRS")[1]))
    // Exclui abatimentos (tipos com '-'), adiantamentos, provisórios e impostos
    cQuery += "   AND SUBSTRING(SE2.E2_TIPO, 3, 1) <> '-' "
    cQuery += "   AND SE2.E2_TIPO NOT IN ('PA ', 'NDF', 'PR ', 'TX ', 'ISS', 'INS') "

    If nSituac == SIT_SEM_RISCO
        // Somente candidatos: em aberto, sem baixa parcial e fora de borderô
        cQuery += "   AND (SE2.E2_XRISCO <> ? OR RTRIM(SE2.E2_XRISCO) IS NULL) "
        aAdd(aBind, RS_RISCO_SIM)
        cQuery += "   AND SE2.E2_SALDO > 0 "
        cQuery += "   AND SE2.E2_NUMBOR = ? "
        aAdd(aBind, Space(TamSX3("E2_NUMBOR")[1]))
    ElseIf nSituac == SIT_INCONSIST
        // Antecipação incompleta: Em processamento, Antecipado sem baixa ou Disponível já baixado
        cQuery += "   AND SE2.E2_XRISCO = ? "
        aAdd(aBind, RS_RISCO_SIM)
        cQuery += "   AND (   SE2.E2_XSTRIC = ? "
        aAdd(aBind, RS_PROCESSANDO)
        cQuery += "        OR (SE2.E2_XSTRIC = ? AND SE2.E2_SALDO > 0) "
        aAdd(aBind, RS_ANTECIPADO)
        cQuery += "        OR (SE2.E2_XSTRIC = ? AND SE2.E2_SALDO <= 0) ) "
        aAdd(aBind, RS_DISPONIVEL)
    Else
        cQuery += "   AND SE2.E2_XRISCO = ? "
        aAdd(aBind, RS_RISCO_SIM)
        If nSituac == SIT_DISPONIVEL
            cQuery += "   AND SE2.E2_XSTRIC = ? "
            aAdd(aBind, RS_DISPONIVEL)
        ElseIf nSituac == SIT_ANTECIPADO
            cQuery += "   AND SE2.E2_XSTRIC = ? "
            aAdd(aBind, RS_ANTECIPADO)
        ElseIf nSituac == SIT_EM_ABERTO
            cQuery += "   AND SE2.E2_XSTRIC = ? "
            aAdd(aBind, RS_EM_ABERTO)
        EndIf
    EndIf

    cQuery += " ORDER BY SE2.E2_FILIAL, SE2.E2_XLOTRS, SE2.E2_VENCREA, SE2.E2_PREFIXO, SE2.E2_NUM, SE2.E2_PARCELA "

    oStatement := FWExecStatement():New(ChangeQuery(cQuery))
    For nI := 1 To Len(aBind)
        oStatement:SetString(nI, aBind[nI])
    Next nI
    cAliasQry := oStatement:OpenAlias(GetNextAlias())

    While !(cAliasQry)->(Eof())
        RecLock(cAlias, .T.)
        (cAlias)->TR_OK     := Space(2)
        (cAlias)->TR_FILIAL := (cAliasQry)->E2_FILIAL
        (cAlias)->TR_LOTE   := (cAliasQry)->E2_XLOTRS
        (cAlias)->TR_RISCO  := (cAliasQry)->E2_XRISCO
        (cAlias)->TR_STATUS := (cAliasQry)->E2_XSTRIC
        (cAlias)->TR_SITUAC := U_PXRSDescSituacao((cAliasQry)->E2_XRISCO, (cAliasQry)->E2_XSTRIC)
        (cAlias)->TR_PREFIX := (cAliasQry)->E2_PREFIXO
        (cAlias)->TR_NUM    := (cAliasQry)->E2_NUM
        (cAlias)->TR_PARCEL := (cAliasQry)->E2_PARCELA
        (cAlias)->TR_TIPO   := (cAliasQry)->E2_TIPO
        (cAlias)->TR_FORNEC := (cAliasQry)->E2_FORNECE
        (cAlias)->TR_LOJA   := (cAliasQry)->E2_LOJA
        (cAlias)->TR_NOMFOR := (cAliasQry)->E2_NOMFOR
        (cAlias)->TR_NATURE := (cAliasQry)->E2_NATUREZ
        (cAlias)->TR_EMISSA := StoD((cAliasQry)->E2_EMISSAO)
        (cAlias)->TR_VENCRE := StoD((cAliasQry)->E2_VENCREA)
        (cAlias)->TR_VALOR  := (cAliasQry)->E2_VALOR
        (cAlias)->TR_SALDO  := (cAliasQry)->E2_SALDO
        (cAlias)->TR_NUMBOR := (cAliasQry)->E2_NUMBOR
        (cAlias)->TR_XBANCO := (cAliasQry)->E2_XBANCO
        (cAlias)->TR_DTANT  := StoD((cAliasQry)->E2_XDTANT)
        (cAlias)->TR_RECSE2 := (cAliasQry)->RECSE2
        (cAlias)->(MsUnlock())
        nQtd++
        (cAliasQry)->(DbSkip())
    EndDo

    (cAliasQry)->(DbCloseArea())
    oStatement:Destroy()
    oStatement := Nil
Return nQtd

/*/{Protheus.doc} DefineColunas
Monta as colunas do FWMarkBrowse.
@type static function
@author bacoetrom
@since 19/10/2026
@param cAlias, character, alias da tabela temporária
@return array, colunas no formato aceito por SetColumns
/*/
Static Function DefineColunas(cAlias as character) as array
    Local aColunas := {} as array
    Local aDef     := {} as array
    Local nI       := 0 as numeric
    Local bDado    as codeblock

    // {Campo, Título, Picture, Tamanho, Decimais, Alinhamento (0=Centro;1=Esquerda;2=Direita)}
    aAdd(aDef, {"TR_FILIAL", "Filial"      , "@!"                  , TamSX3("E2_FILIAL")[1]  , 0                     , 1})
    aAdd(aDef, {"TR_LOTE"  , "Lote"        , "@!"                  , TamSX3("E2_XLOTRS")[1]  , 0                     , 1})
    aAdd(aDef, {"TR_SITUAC", "Situação"    , "@!"                  , 20                      , 0                     , 1})
    aAdd(aDef, {"TR_PREFIX", "Prefixo"     , "@!"                  , TamSX3("E2_PREFIXO")[1] , 0                     , 1})
    aAdd(aDef, {"TR_NUM"   , "Número"      , "@!"                  , TamSX3("E2_NUM")[1]     , 0                     , 1})
    aAdd(aDef, {"TR_PARCEL", "Parcela"     , "@!"                  , TamSX3("E2_PARCELA")[1] , 0                     , 1})
    aAdd(aDef, {"TR_TIPO"  , "Tipo"        , "@!"                  , TamSX3("E2_TIPO")[1]    , 0                     , 1})
    aAdd(aDef, {"TR_FORNEC", "Fornecedor"  , "@!"                  , TamSX3("E2_FORNECE")[1] , 0                     , 1})
    aAdd(aDef, {"TR_LOJA"  , "Loja"        , "@!"                  , TamSX3("E2_LOJA")[1]    , 0                     , 1})
    aAdd(aDef, {"TR_NOMFOR", "Nome"        , "@!"                  , TamSX3("E2_NOMFOR")[1]  , 0                     , 1})
    aAdd(aDef, {"TR_NATURE", "Natureza"    , "@!"                  , TamSX3("E2_NATUREZ")[1] , 0                     , 1})
    aAdd(aDef, {"TR_EMISSA", "Emissão"     , ""                    , 10                      , 0                     , 0})
    aAdd(aDef, {"TR_VENCRE", "Vencto Real" , ""                    , 10                      , 0                     , 0})
    aAdd(aDef, {"TR_VALOR" , "Valor"       , X3Picture("E2_VALOR") , TamSX3("E2_VALOR")[1]   , TamSX3("E2_VALOR")[2] , 2})
    aAdd(aDef, {"TR_SALDO" , "Saldo"       , X3Picture("E2_SALDO") , TamSX3("E2_SALDO")[1]   , TamSX3("E2_SALDO")[2] , 2})
    aAdd(aDef, {"TR_NUMBOR", "Borderô"     , "@!"                  , TamSX3("E2_NUMBOR")[1]  , 0                     , 1})
    aAdd(aDef, {"TR_XBANCO", "Banco Risco" , "@!"                  , TamSX3("E2_XBANCO")[1]  , 0                     , 1})
    aAdd(aDef, {"TR_DTANT" , "Dt.Antecip." , ""                    , 10                      , 0                     , 0})

    For nI := 1 To Len(aDef)
        bDado := &("{|| ('" + cAlias + "')->" + aDef[nI][1] + "}")
        // Estrutura da coluna: título, bloco de dados, tipo, máscara, alinhamento, tamanho, decimal,
        // edita, bValid, imagem, bDuploClique, ReadVar, bHeaderClick, deletada, detalhe, opções
        aAdd(aColunas, {aDef[nI][2], bDado, Nil, aDef[nI][3], aDef[nI][6], aDef[nI][4], aDef[nI][5], ;
                        .F., {|| .T.}, .F., {|| .T.}, Nil, {|| .T.}, .F., .F., {}})
    Next nI
Return aColunas

/*/{Protheus.doc} MarcaTodos
Marca, desmarca ou inverte a seleção de todos os registros do browse.
@type static function
@author bacoetrom
@since 19/10/2026
@param oMark, object, FWMarkBrowse
@param nModo, numeric, 1=Marcar todos; 2=Desmarcar todos; 3=Inverter
@return logical, sempre .T.
/*/
Static Function MarcaTodos(oMark as object, nModo as numeric) as logical
    Local cAlias := oMark:Alias() as character
    Local cMarca := oMark:Mark() as character
    Local nRecno := (cAlias)->(Recno()) as numeric

    (cAlias)->(DbGoTop())
    While !(cAlias)->(Eof())
        RecLock(cAlias, .F.)
        If nModo == 1
            (cAlias)->TR_OK := cMarca
        ElseIf nModo == 2
            (cAlias)->TR_OK := Space(2)
        ElseIf (cAlias)->TR_OK == cMarca
            (cAlias)->TR_OK := Space(2)
        Else
            (cAlias)->TR_OK := cMarca
        EndIf
        (cAlias)->(MsUnlock())
        (cAlias)->(DbSkip())
    EndDo

    (cAlias)->(DbGoTo(nRecno))
    oMark:Refresh(.T.)
Return .T.

/*/{Protheus.doc} ColetaMarcados
Retorna os títulos marcados no browse.
@type static function
@author bacoetrom
@since 19/10/2026
@param oMark, object, FWMarkBrowse
@return array, {{nRecSE2, cFilTit, cLote, cRisco}, ...}
/*/
Static Function ColetaMarcados(oMark as object) as array
    Local aSel   := {} as array
    Local cAlias := oMark:Alias() as character
    Local cMarca := oMark:Mark() as character
    Local nRecno := (cAlias)->(Recno()) as numeric

    (cAlias)->(DbGoTop())
    While !(cAlias)->(Eof())
        If (cAlias)->TR_OK == cMarca
            aAdd(aSel, {(cAlias)->TR_RECSE2, (cAlias)->TR_FILIAL, (cAlias)->TR_LOTE, (cAlias)->TR_RISCO})
        EndIf
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbGoTo(nRecno))
Return aSel

/*/{Protheus.doc} AcaoDisponibilizar
Ação "Disponibilizar": envia os títulos marcados ao banco, gerando um lote por filial.
@type static function
@author bacoetrom
@since 19/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, .T. quando processado
/*/
Static Function AcaoDisponibilizar(oMark as object, aPar as array) as logical
    Local aSel     := {} as array
    Local aFiliais := {} as array
    Local aForn    := {} as array
    Local aLog     := {} as array
    Local cBanco   := "" as character
    Local cFilTit  := "" as character
    Local nI       := 0 as numeric
    Local nPos     := 0 as numeric

    cBanco := aPar[PAR_BCORS]
    If Empty(cBanco)
        FWAlertWarning("Informe o banco do risco sacado no parâmetro 'Banco do risco sacado'.", RS_TITULO)
        Return .F.
    EndIf

    aSel := ColetaMarcados(oMark)
    If Empty(aSel)
        FWAlertWarning("Nenhum título marcado.", RS_TITULO)
        Return .F.
    EndIf

    If !MsgYesNo("Confirma disponibilizar " + cValToChar(Len(aSel)) + " título(s) ao banco " + ;
                 AllTrim(cBanco) + " no Risco Sacado?" + CRLF + "Será gerado um lote por filial.", RS_TITULO)
        Return .F.
    EndIf

    // Agrupa os títulos por filial (um lote por filial)
    For nI := 1 To Len(aSel)
        If aSel[nI][MRK_RISCO] == RS_RISCO_SIM
            aAdd(aLog, "Filial " + AllTrim(aSel[nI][MRK_FILIAL]) + " recno " + cValToChar(aSel[nI][MRK_RECNO]) + ;
                       ": título já está em risco sacado (lote " + AllTrim(aSel[nI][MRK_LOTE]) + ").")
            Loop
        EndIf
        nPos := aScan(aFiliais, {|x| x[1] == aSel[nI][MRK_FILIAL]})
        If nPos == 0
            aAdd(aFiliais, {aSel[nI][MRK_FILIAL], {}})
            nPos := Len(aFiliais)
        EndIf
        aAdd(aFiliais[nPos][2], aSel[nI][MRK_RECNO])
    Next nI

    SA2->(DbSetOrder(1)) // A2_FILIAL+A2_COD+A2_LOJA
    For nI := 1 To Len(aFiliais)
        cFilTit := aFiliais[nI][1]
        aForn   := U_PXRSFornBanco(cFilTit, cBanco)
        If Empty(aForn[1])
            aAdd(aLog, "Filial " + AllTrim(cFilTit) + ": banco " + AllTrim(cBanco) + ;
                       " sem fornecedor (A6_XFORN/A6_XLOJA) informado. Títulos não processados.")
        ElseIf !SA2->(DbSeek(xFilial("SA2", cFilTit) + aForn[1] + aForn[2]))
            aAdd(aLog, "Filial " + AllTrim(cFilTit) + ": fornecedor " + AllTrim(aForn[1]) + "/" + AllTrim(aForn[2]) + ;
                       " do banco não cadastrado. Títulos não processados.")
        Else
            ProcessaLote(cFilTit, cBanco, aForn, aFiliais[nI][2], aLog)
        EndIf
    Next nI

    MostraLog(aLog)
    Recarrega(oMark, aPar)
Return .T.

/*/{Protheus.doc} ProcessaLote
Gera o lote de risco sacado de uma filial e marca os títulos elegíveis como Disponível.
@type static function
@author bacoetrom
@since 19/10/2026
@param cFilTit, character, filial dos títulos
@param cBanco, character, banco do risco sacado
@param aForn, array, {fornecedor, loja} do banco
@param aRecnos, array, R_E_C_N_O_ dos títulos da filial
@param aLog, array, log de processamento (por referência)
@return logical, .T. quando ao menos um título foi gravado
/*/
Static Function ProcessaLote(cFilTit as character, cBanco as character, aForn as array, aRecnos as array, aLog as array) as logical
    Local cLote   := "" as character
    Local cMotivo := "" as character
    Local nI      := 0 as numeric
    Local nOk     := 0 as numeric

    cLote := ProximoLote(cFilTit)

    Begin Transaction
        For nI := 1 To Len(aRecnos)
            SE2->(DbGoTo(aRecnos[nI]))
            cMotivo := U_PXRSValidaElegivel(aForn[1], aForn[2])
            If !Empty(cMotivo)
                aAdd(aLog, ChaveTitulo() + ": " + cMotivo)
                Loop
            EndIf
            RecLock("SE2", .F.)
            SE2->E2_XLOTRS  := cLote
            SE2->E2_XBANCO  := cBanco
            SE2->E2_XRISCO  := RS_RISCO_SIM
            SE2->E2_XDTRISC := dDataBase
            SE2->E2_XSTRIC  := RS_DISPONIVEL
            SE2->(MsUnlock())
            nOk++
        Next nI
    End Transaction

    If nOk > 0
        ConfirmSX8()
        aAdd(aLog, "Filial " + AllTrim(cFilTit) + ": lote " + cLote + " gerado com " + cValToChar(nOk) + " título(s) disponível(is).")
        U_PXRSLog("INFO", "Lote de risco sacado " + cLote + " filial " + AllTrim(cFilTit) + " banco " + AllTrim(cBanco) + ;
                          " - " + cValToChar(nOk) + " título(s) - usuário " + AllTrim(UsrRetName(RetCodUsr())))
    Else
        RollBackSX8()
    EndIf
Return nOk > 0

/*/{Protheus.doc} ProximoLote
Obtém o próximo código de lote (6 dígitos) garantindo que não exista na filial.
@type static function
@author bacoetrom
@since 19/10/2026
@param cFilTit, character, filial dos títulos
@return character, código do lote
/*/
Static Function ProximoLote(cFilTit as character) as character
    Local cLote := "" as character

    cLote := GetSXENum("SE2", "E2_XLOTRS")
    While LoteExiste(cFilTit, cLote)
        ConfirmSX8()
        cLote := GetSXENum("SE2", "E2_XLOTRS")
    EndDo
Return cLote

/*/{Protheus.doc} LoteExiste
Verifica se o código de lote já foi usado na filial.
@type static function
@author bacoetrom
@since 19/10/2026
@param cFilTit, character, filial
@param cLote, character, código do lote
@return logical, .T. quando já existe
/*/
Static Function LoteExiste(cFilTit as character, cLote as character) as logical
    Local cQuery     := "" as character
    Local xQtd       as variant
    Local oStatement as object

    cQuery := "SELECT COUNT(*) QTD "
    cQuery += "  FROM " + RetSqlName("SE2") + " SE2 "
    cQuery += " WHERE SE2.D_E_L_E_T_ = ? "
    cQuery += "   AND SE2.E2_FILIAL = ? "
    cQuery += "   AND SE2.E2_XLOTRS = ? "

    oStatement := FWExecStatement():New(ChangeQuery(cQuery))
    oStatement:SetString(1, " ")
    oStatement:SetString(2, cFilTit)
    oStatement:SetString(3, cLote)
    xQtd := oStatement:ExecScalar("QTD")
    oStatement:Destroy()
    oStatement := Nil
Return ValType(xQtd) == "N" .And. xQtd > 0

/*/{Protheus.doc} AcaoAntecipado
Ação "Antecipado" (1 -> 2): para cada título marcado, baixa o título do fornecedor e gera o
título a pagar do banco (U_PXRSAntecipa). Não há transação envolvendo os ExecAuto (ver o
cabeçalho de PXFINA37S): a falha de um passo é compensada pela própria rotina e, quando a
compensação não é possível, o título fica na situação 9 (Em processamento) para a ação Conciliar.
Somente títulos da filial logada (ExecAuto roda na filial corrente; cFilAnt não é trocado).
@type static function
@author bacoetrom
@since 19/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, .T. quando processado
/*/
Static Function AcaoAntecipado(oMark as object, aPar as array) as logical
    Local aSel := {} as array
    Local aLog := {} as array
    Local nOk  := 0 as numeric
    Local jCfg as json

    aSel := ColetaMarcados(oMark)
    If Empty(aSel)
        FWAlertWarning("Nenhum título marcado.", RS_TITULO)
        Return .F.
    EndIf

    If !MsgYesNo("Confirma 'Antecipado' para " + cValToChar(Len(aSel)) + " título(s)?" + CRLF + ;
                 "O título do fornecedor será baixado e será gerado um título a pagar para o banco.", RS_TITULO)
        Return .F.
    EndIf

    // Parâmetros lidos uma única vez, fora do laço
    jCfg := U_PXRSConfig()

    FWMsgRun(, {|| nOk := ProcessaAntecipacao(aSel, jCfg, aLog)}, RS_TITULO, "Antecipando títulos...")

    aAdd(aLog, "Antecipado: " + cValToChar(nOk) + " de " + cValToChar(Len(aSel)) + " título(s) processado(s).")
    MostraLog(aLog)
    Recarrega(oMark, aPar)
Return .T.

/*/{Protheus.doc} ProcessaAntecipacao
Processa a antecipação dos títulos selecionados (sem interface; mensagens no log).
Cada título é processado isoladamente e protegido por Try/Catch: um erro de execução não
interrompe a lista nem deixa o laço sem registro do que aconteceu.
Se sobrar transação aberta após um título (o padrão pode sair de dentro da própria transação),
o processamento é interrompido: continuar efetivaria gravações pendentes do título anterior.
@type static function
@author bacoetrom
@since 19/10/2026
@param aSel, array, títulos marcados
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@param aLog, array, log de processamento (por referência)
@return numeric, quantidade de títulos antecipados
/*/
Static Function ProcessaAntecipacao(aSel as array, jCfg as json, aLog as array) as numeric
    Local cMsg  := "" as character
    Local nI    := 0 as numeric
    Local nOk   := 0 as numeric
    Local oErro as object

    For nI := 1 To Len(aSel)
        SE2->(DbGoTo(aSel[nI][MRK_RECNO]))
        If aSel[nI][MRK_FILIAL] <> xFilial("SE2")
            aAdd(aLog, ChaveTitulo() + ": título de outra filial. Acesse a filial " + AllTrim(aSel[nI][MRK_FILIAL]) + " para antecipar.")
            Loop
        EndIf

        cMsg := ""
        Try
            cMsg := U_PXRSAntecipa(aSel[nI][MRK_RECNO], jCfg)
        Catch oErro
            cMsg := "erro inesperado na antecipação: " + oErro:Description
            U_PXRSLog("ERROR", "ProcessaAntecipacao: " + cMsg)
        EndTry

        SE2->(DbGoTo(aSel[nI][MRK_RECNO]))
        If Empty(cMsg)
            nOk++
        Else
            aAdd(aLog, ChaveTitulo() + ": " + cMsg)
        EndIf

        If InTransact()
            aAdd(aLog, "Processamento interrompido: transação aberta após o título acima. " + ;
                       "Os títulos restantes não foram processados. Confira a situação pelo filtro 'Inconsistentes'.")
            U_PXRSLog("ERROR", "ProcessaAntecipacao: transação aberta após " + ChaveTitulo())
            Exit
        EndIf
    Next nI
Return nOk

/*/{Protheus.doc} AcaoEmAberto
Ação "Em aberto" (1 -> 3): o fornecedor não antecipou; o título volta ao fluxo normal.
@type static function
@author bacoetrom
@since 19/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, .T. quando processado
/*/
Static Function AcaoEmAberto(oMark as object, aPar as array) as logical
    Local aSel := {} as array
    Local aLog := {} as array
    Local nI   := 0 as numeric
    Local nOk  := 0 as numeric

    aSel := ColetaMarcados(oMark)
    If Empty(aSel)
        FWAlertWarning("Nenhum título marcado.", RS_TITULO)
        Return .F.
    EndIf

    If !MsgYesNo("Confirma 'Em aberto' para " + cValToChar(Len(aSel)) + " título(s)?" + CRLF + ;
                 "Os títulos voltarão ao fluxo normal do Contas a Pagar.", RS_TITULO)
        Return .F.
    EndIf

    Begin Transaction
        For nI := 1 To Len(aSel)
            SE2->(DbGoTo(aSel[nI][MRK_RECNO]))
            If SE2->(Eof()) .Or. SE2->E2_XRISCO <> RS_RISCO_SIM .Or. SE2->E2_XSTRIC <> RS_DISPONIVEL
                aAdd(aLog, ChaveTitulo() + ": somente títulos 'Disponível' podem ir para 'Em aberto'.")
                Loop
            EndIf
            RecLock("SE2", .F.)
            SE2->E2_XSTRIC := RS_EM_ABERTO
            SE2->(MsUnlock())
            nOk++
        Next nI
    End Transaction

    aAdd(aLog, "Em aberto: " + cValToChar(nOk) + " título(s) atualizado(s).")
    U_PXRSLog("INFO", "Em aberto: " + cValToChar(nOk) + " título(s) - usuário " + AllTrim(UsrRetName(RetCodUsr())))
    MostraLog(aLog)
    Recarrega(oMark, aPar)
Return .T.

/*/{Protheus.doc} AcaoEstorno
Ação "Estornar Situação":
  3 -> 1 : somente sem baixa e fora de borderô (título não movimentado após o envio).
  2 -> 1 : exclui o título do banco e cancela a baixa do fornecedor (U_PXRSEstornaAntecipacao),
           somente na filial logada e com o título do banco sem baixa e fora de borderô.
@type static function
@author bacoetrom
@since 19/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, .T. quando processado
/*/
Static Function AcaoEstorno(oMark as object, aPar as array) as logical
    Local aSel := {} as array
    Local aLog := {} as array
    Local nOk  := 0 as numeric

    aSel := ColetaMarcados(oMark)
    If Empty(aSel)
        FWAlertWarning("Nenhum título marcado.", RS_TITULO)
        Return .F.
    EndIf

    If !MsgYesNo("Confirma 'Estornar Situação' (voltar para 'Disponível') para " + cValToChar(Len(aSel)) + " título(s)?" + CRLF + ;
                 "Títulos antecipados terão o título do banco excluído e a baixa cancelada.", RS_TITULO)
        Return .F.
    EndIf

    FWMsgRun(, {|| nOk := ProcessaEstorno(aSel, aLog)}, RS_TITULO, "Estornando situação...")

    aAdd(aLog, "Estornar Situação: " + cValToChar(nOk) + " de " + cValToChar(Len(aSel)) + " título(s) estornado(s).")
    U_PXRSLog("INFO", "Estornar Situação: " + cValToChar(nOk) + " título(s) - usuário " + AllTrim(UsrRetName(RetCodUsr())))
    MostraLog(aLog)
    Recarrega(oMark, aPar)
Return .T.

/*/{Protheus.doc} ProcessaEstorno
Processa o estorno de situação dos títulos selecionados (sem interface; mensagens no log).
Cada título é protegido por Try/Catch e o laço é interrompido se sobrar transação aberta.
@type static function
@author bacoetrom
@since 19/10/2026
@param aSel, array, títulos marcados
@param aLog, array, log de processamento (por referência)
@return numeric, quantidade de títulos estornados
/*/
Static Function ProcessaEstorno(aSel as array, aLog as array) as numeric
    Local cMsg  := "" as character
    Local nI    := 0 as numeric
    Local nOk   := 0 as numeric
    Local oErro as object

    For nI := 1 To Len(aSel)
        SE2->(DbGoTo(aSel[nI][MRK_RECNO]))
        cMsg := ""

        If SE2->(Eof()) .Or. SE2->E2_XRISCO <> RS_RISCO_SIM
            cMsg := "título não está em risco sacado."
        ElseIf SE2->E2_XSTRIC == RS_DISPONIVEL
            cMsg := "título já está 'Disponível'."
        ElseIf SE2->E2_XSTRIC == RS_PROCESSANDO
            cMsg := "título está 'Em processamento'; use a ação Conciliar."
        ElseIf SE2->E2_XSTRIC == RS_EM_ABERTO
            If SE2->E2_SALDO < SE2->E2_VALOR - RS_TOLERANCIA
                cMsg := "título 'Em aberto' possui baixa após o envio ao banco."
            ElseIf !Empty(SE2->E2_NUMBOR)
                cMsg := "título 'Em aberto' está no borderô " + AllTrim(SE2->E2_NUMBOR) + "."
            Else
                Begin Transaction
                    RecLock("SE2", .F.)
                    SE2->E2_XSTRIC := RS_DISPONIVEL
                    SE2->(MsUnlock())
                End Transaction
            EndIf
        ElseIf SE2->E2_XSTRIC == RS_ANTECIPADO
            Try
                cMsg := U_PXRSEstornaAntecipacao(aSel[nI][MRK_RECNO])
            Catch oErro
                cMsg := "erro inesperado no estorno: " + oErro:Description
                U_PXRSLog("ERROR", "ProcessaEstorno: " + cMsg)
            EndTry
        Else
            cMsg := "situação atual não permite estorno."
        EndIf

        SE2->(DbGoTo(aSel[nI][MRK_RECNO]))
        If Empty(cMsg)
            nOk++
        Else
            aAdd(aLog, ChaveTitulo() + ": " + cMsg)
        EndIf

        If InTransact()
            aAdd(aLog, "Processamento interrompido: transação aberta após o título acima. " + ;
                       "Os títulos restantes não foram processados. Confira a situação pelo filtro 'Inconsistentes'.")
            U_PXRSLog("ERROR", "ProcessaEstorno: transação aberta após " + ChaveTitulo())
            Exit
        EndIf
    Next nI
Return nOk

/*/{Protheus.doc} AcaoConcilia
Ação "Conciliar": resolve os títulos cuja antecipação ficou incompleta, decidindo pelo estado
real dos registros (baixa do fornecedor e existência do título a pagar do banco). Atende tanto
os títulos deixados na situação 9 (Em processamento) quanto os que ficaram inconsistentes antes
da correção da rotina (Disponível já baixado ou Antecipado sem baixa).
@type static function
@author bacoetrom
@since 28/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, .T. quando processado
/*/
Static Function AcaoConcilia(oMark as object, aPar as array) as logical
    Local aSel := {} as array
    Local aLog := {} as array
    Local nOk  := 0 as numeric
    Local jCfg as json

    aSel := ColetaMarcados(oMark)
    If Empty(aSel)
        FWAlertWarning("Nenhum título marcado.", RS_TITULO)
        Return .F.
    EndIf

    If !MsgYesNo("Confirma a conciliação de " + cValToChar(Len(aSel)) + " título(s)?" + CRLF + ;
                 "Título com baixa e com título do banco: marcado como 'Antecipado'." + CRLF + ;
                 "Título com baixa e sem título do banco: o título do banco será gerado." + CRLF + ;
                 "Demais casos: a antecipação será desfeita e o título volta para 'Disponível'.", RS_TITULO)
        Return .F.
    EndIf

    // Parâmetros lidos uma única vez, fora do laço
    jCfg := U_PXRSConfig()

    FWMsgRun(, {|| nOk := ProcessaConciliacao(aSel, jCfg, aLog)}, RS_TITULO, "Conciliando títulos...")

    aAdd(aLog, "Conciliar: " + cValToChar(nOk) + " de " + cValToChar(Len(aSel)) + " título(s) conciliado(s).")
    U_PXRSLog("INFO", "Conciliar: " + cValToChar(nOk) + " título(s) - usuário " + AllTrim(UsrRetName(RetCodUsr())))
    MostraLog(aLog)
    Recarrega(oMark, aPar)
Return .T.

/*/{Protheus.doc} ProcessaConciliacao
Processa a conciliação dos títulos selecionados (sem interface; mensagens no log).
@type static function
@author bacoetrom
@since 28/10/2026
@param aSel, array, títulos marcados
@param jCfg, json, parâmetros lidos por U_PXRSConfig
@param aLog, array, log de processamento (por referência)
@return numeric, quantidade de títulos conciliados
/*/
Static Function ProcessaConciliacao(aSel as array, jCfg as json, aLog as array) as numeric
    Local cMsg  := "" as character
    Local nI    := 0 as numeric
    Local nOk   := 0 as numeric
    Local oErro as object

    For nI := 1 To Len(aSel)
        SE2->(DbGoTo(aSel[nI][MRK_RECNO]))
        If aSel[nI][MRK_FILIAL] <> xFilial("SE2")
            aAdd(aLog, ChaveTitulo() + ": título de outra filial. Acesse a filial " + AllTrim(aSel[nI][MRK_FILIAL]) + " para conciliar.")
            Loop
        EndIf

        cMsg := ""
        Try
            cMsg := U_PXRSConcilia(aSel[nI][MRK_RECNO], jCfg)
        Catch oErro
            cMsg := "erro inesperado na conciliação: " + oErro:Description
            U_PXRSLog("ERROR", "ProcessaConciliacao: " + cMsg)
        EndTry

        SE2->(DbGoTo(aSel[nI][MRK_RECNO]))
        If Empty(cMsg)
            nOk++
        Else
            aAdd(aLog, ChaveTitulo() + ": " + cMsg)
        EndIf

        If InTransact()
            aAdd(aLog, "Processamento interrompido: transação aberta após o título acima. " + ;
                       "Os títulos restantes não foram conciliados.")
            U_PXRSLog("ERROR", "ProcessaConciliacao: transação aberta após " + ChaveTitulo())
            Exit
        EndIf
    Next nI
Return nOk

/*/{Protheus.doc} AcaoExcluirLote
Exclui os lotes dos títulos marcados, devolvendo todos os títulos do lote para "sem risco".
Permitido somente se nenhum título do lote estiver Antecipado ou movimentado após o envio.
@type static function
@author bacoetrom
@since 19/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, .T. quando processado
/*/
Static Function AcaoExcluirLote(oMark as object, aPar as array) as logical
    Local aSel    := {} as array
    Local aLotes  := {} as array
    Local aLog    := {} as array
    Local aRecnos := {} as array
    Local cLotes  := "" as character
    Local cMotivo := "" as character
    Local nI      := 0 as numeric
    Local nJ      := 0 as numeric

    aSel := ColetaMarcados(oMark)
    For nI := 1 To Len(aSel)
        If !Empty(aSel[nI][MRK_LOTE]) .And. ;
           aScan(aLotes, {|x| x[1] == aSel[nI][MRK_FILIAL] .And. x[2] == aSel[nI][MRK_LOTE]}) == 0
            aAdd(aLotes, {aSel[nI][MRK_FILIAL], aSel[nI][MRK_LOTE]})
            cLotes += CRLF + "Filial " + AllTrim(aSel[nI][MRK_FILIAL]) + " - lote " + aSel[nI][MRK_LOTE]
        EndIf
    Next nI

    If Empty(aLotes)
        FWAlertWarning("Nenhum título marcado pertence a um lote de risco sacado.", RS_TITULO)
        Return .F.
    EndIf

    If !MsgYesNo("Confirma a exclusão do(s) lote(s) abaixo? Todos os títulos do lote voltarão para 'Sem risco'." + cLotes, RS_TITULO)
        Return .F.
    EndIf

    For nI := 1 To Len(aLotes)
        aRecnos := TitulosDoLote(aLotes[nI][1], aLotes[nI][2])
        cMotivo := ""
        For nJ := 1 To Len(aRecnos)
            SE2->(DbGoTo(aRecnos[nJ]))
            If SE2->E2_XSTRIC == RS_ANTECIPADO
                cMotivo := ChaveTitulo() + " está Antecipado. Estorne a antecipação antes."
                Exit
            ElseIf SE2->E2_SALDO < SE2->E2_VALOR - RS_TOLERANCIA
                cMotivo := ChaveTitulo() + " possui baixa após o envio ao banco."
                Exit
            ElseIf !Empty(SE2->E2_NUMBOR)
                cMotivo := ChaveTitulo() + " está no borderô " + AllTrim(SE2->E2_NUMBOR) + "."
                Exit
            EndIf
        Next nJ

        If !Empty(cMotivo)
            aAdd(aLog, "Lote " + aLotes[nI][2] + " (filial " + AllTrim(aLotes[nI][1]) + ") não excluído: " + cMotivo)
            Loop
        EndIf

        Begin Transaction
            For nJ := 1 To Len(aRecnos)
                SE2->(DbGoTo(aRecnos[nJ]))
                RecLock("SE2", .F.)
                SE2->E2_XLOTRS  := Space(TamSX3("E2_XLOTRS")[1])
                SE2->E2_XBANCO  := Space(TamSX3("E2_XBANCO")[1])
                SE2->E2_XDTRISC := CtoD("")
                SE2->E2_XDTANT  := CtoD("")
                SE2->E2_XSTRIC  := Space(TamSX3("E2_XSTRIC")[1])
                SE2->E2_XRISCO  := RS_RISCO_NAO
                SE2->(MsUnlock())
            Next nJ
        End Transaction

        aAdd(aLog, "Lote " + aLotes[nI][2] + " (filial " + AllTrim(aLotes[nI][1]) + ") excluído: " + ;
                   cValToChar(Len(aRecnos)) + " título(s) devolvido(s) para 'Sem risco'.")
        U_PXRSLog("INFO", "Lote " + aLotes[nI][2] + " filial " + AllTrim(aLotes[nI][1]) + " excluído - usuário " + ;
                          AllTrim(UsrRetName(RetCodUsr())))
    Next nI

    MostraLog(aLog)
    Recarrega(oMark, aPar)
Return .T.

/*/{Protheus.doc} TitulosDoLote
Retorna os R_E_C_N_O_ de todos os títulos de um lote.
@type static function
@author bacoetrom
@since 19/10/2026
@param cFilTit, character, filial
@param cLote, character, código do lote
@return array, R_E_C_N_O_ da SE2
/*/
Static Function TitulosDoLote(cFilTit as character, cLote as character) as array
    Local aRecnos    := {} as array
    Local cQuery     := "" as character
    Local cAliasQry  := "" as character
    Local oStatement as object

    cQuery := "SELECT SE2.R_E_C_N_O_ RECSE2 "
    cQuery += "  FROM " + RetSqlName("SE2") + " SE2 "
    cQuery += " WHERE SE2.D_E_L_E_T_ = ? "
    cQuery += "   AND SE2.E2_FILIAL = ? "
    cQuery += "   AND SE2.E2_XLOTRS = ? "
    cQuery += "   AND SE2.E2_XORIRS = ? "

    oStatement := FWExecStatement():New(ChangeQuery(cQuery))
    oStatement:SetString(1, " ")
    oStatement:SetString(2, cFilTit)
    oStatement:SetString(3, cLote)
    oStatement:SetString(4, Space(TamSX3("E2_XORIRS")[1]))
    cAliasQry := oStatement:OpenAlias(GetNextAlias())

    While !(cAliasQry)->(Eof())
        aAdd(aRecnos, (cAliasQry)->RECSE2)
        (cAliasQry)->(DbSkip())
    EndDo

    (cAliasQry)->(DbCloseArea())
    oStatement:Destroy()
    oStatement := Nil
Return aRecnos

/*/{Protheus.doc} Recarrega
Recarrega a tabela temporária após uma ação e atualiza o browse.
@type static function
@author bacoetrom
@since 19/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, sempre .T.
/*/
Static Function Recarrega(oMark as object, aPar as array) as logical
    Local cAlias := oMark:Alias() as character

    (cAlias)->(DbGoTop())
    While !(cAlias)->(Eof())
        RecLock(cAlias, .F.)
        (cAlias)->(DbDelete())
        (cAlias)->(MsUnlock())
        (cAlias)->(DbSkip())
    EndDo

    FWMsgRun(, {|| CarregaTitulos(cAlias, aPar)}, RS_TITULO, "Atualizando títulos...")
    (cAlias)->(DbGoTop())
    oMark:Refresh(.T.)
Return .T.

/*/{Protheus.doc} ChaveTitulo
Identificação do título posicionado na SE2 para mensagens.
@type static function
@author bacoetrom
@since 19/10/2026
@return character, filial/prefixo/número/parcela/tipo/fornecedor
/*/
Static Function ChaveTitulo() as character
Return "Título " + AllTrim(SE2->E2_FILIAL) + "/" + AllTrim(SE2->E2_PREFIXO) + "/" + AllTrim(SE2->E2_NUM) + ;
       "/" + AllTrim(SE2->E2_PARCELA) + "/" + AllTrim(SE2->E2_TIPO) + " forn. " + AllTrim(SE2->E2_FORNECE)

/*/{Protheus.doc} MostraLog
Exibe o resumo do processamento (limitado a RS_MAX_LOG linhas; todas vão para o log do servidor).
@type static function
@author bacoetrom
@since 19/10/2026
@param aLog, array, mensagens
@return logical, sempre .T.
/*/
Static Function MostraLog(aLog as array) as logical
    Local cTexto := "" as character
    Local nI     := 0 as numeric

    If Empty(aLog)
        Return .T.
    EndIf

    For nI := 1 To Len(aLog)
        U_PXRSLog("INFO", aLog[nI])
        If nI <= RS_MAX_LOG
            cTexto += aLog[nI] + CRLF
        EndIf
    Next nI

    If Len(aLog) > RS_MAX_LOG
        cTexto += "... e mais " + cValToChar(Len(aLog) - RS_MAX_LOG) + " mensagem(ns). Consulte o log do servidor (RISCOSACADO)."
    EndIf

    FWAlertInfo(cTexto, RS_TITULO)
Return .T.
