#include "tlpp-core.th"
#include "totvs.ch"

#define RS_PARAM_LOAD "PXFINA37"
#define RS_TITULO     "Risco Sacado"
#define RS_RISCO_SIM  "S"
#define RS_RISCO_NAO  "N"
#define RS_ENVIADO    "1"
#define RS_NAO_PAGO   "2"
#define RS_PAGO       "3"
#define RS_MAX_LOG    40

// Posições do array de parâmetros (ParamBox)
#define PAR_FILDE     1
#define PAR_FILATE    2
#define PAR_VENCDE    3
#define PAR_VENCATE   4
#define PAR_PORTADO   5
#define PAR_AGENCIA   6
#define PAR_CONTA     7
#define PAR_BORDE     8
#define PAR_BORATE    9
#define PAR_LOTEDE    10
#define PAR_LOTEATE   11
#define PAR_SITUAC    12
#define PAR_BCORS     13

// Opções do parâmetro Situação (combo)
#define SIT_SEM_RISCO 1
#define SIT_ENVIADO   2
#define SIT_NAO_PAGO  3
#define SIT_PAGO      4
#define SIT_EM_RISCO  5

// Posições do array de títulos marcados
#define MRK_RECNO     1
#define MRK_FILIAL    2
#define MRK_LOTE      3
#define MRK_RISCO     4

/*/{Protheus.doc} PXFINA37
Risco Sacado - seleção de títulos a receber (SE1) para envio ao banco e controle da
situação de retorno do banco.

Ações:
  - Risco Sacado      : marca os títulos (sem risco) e gera um lote por filial (E1_XLOTRS).
  - Não Pago ao Banco : situação 1 -> 2 (na baixa NOR que liquida o título será gerado SE2 ao banco).
  - Pago ao Banco     : situação 1 -> 3 (baixa manual pelo usuário, sem SE2).
  - Estornar Situação : situação 2/3 -> 1 (somente sem baixa e sem SE2 gerado).
  - Excluir Lote      : devolve todos os títulos do lote para "sem risco" (somente sem baixa).

Parâmetros (ParamBox - última seleção salva por usuário, sem dependência de SX1):
  01 Filial de / 02 Filial até / 03 Vencimento real de / 04 Vencimento real até /
  05 Portador / 06 Agência / 07 Conta (vazios = todos) / 08 Borderô de / 09 Borderô até /
  10 Lote de / 11 Lote até / 12 Situação (1=Sem risco;2=Enviado;3=Não pago;4=Pago;5=Todos em risco) /
  13 Banco do risco sacado (SA6)

@type user function
@author bacoetrom
@since 13/10/2026
@return logical, .T. quando a tela foi aberta
/*/
User Function PXFINA37() as logical
    Local aPar := {} as array

    aPar := Parametros()
    If Empty(aPar)
        Return .F.
    EndIf
Return MontaTela(aPar)

/*/{Protheus.doc} Parametros
Exibe a tela de parâmetros (ParamBox) e devolve as respostas.
A situação (combo) é normalizada para numérico.
@type static function
@author bacoetrom
@since 13/10/2026
@return array, respostas na ordem das constantes PAR_* ou vazio quando cancelado
/*/
Static Function Parametros() as array
    Local aPergs    := {} as array
    Local aRet      := {} as array
    Local aSituacao := {} as array
    Local nTamFil   := TamSX3("E1_FILIAL")[1] as numeric
    Local nTamBor   := TamSX3("E1_NUMBOR")[1] as numeric
    Local nTamLote  := TamSX3("E1_XLOTRS")[1] as numeric

    aSituacao := {"1-Sem risco", "2-Enviado ao Banco", "3-Não pago ao Banco", "4-Pago ao Banco", "5-Todos em risco"}

    aAdd(aPergs, {1, "Filial de"            , Space(nTamFil)                      , "@!", ".T.", "SM0", ".T.", 50, .F.})
    aAdd(aPergs, {1, "Filial até"           , Replicate("Z", nTamFil)             , "@!", ".T.", "SM0", ".T.", 50, .T.})
    aAdd(aPergs, {1, "Vencto real de"       , FirstDay(dDataBase)                 , ""  , ".T.", ""   , ".T.", 50, .T.})
    aAdd(aPergs, {1, "Vencto real até"      , LastDay(dDataBase)                  , ""  , ".T.", ""   , ".T.", 50, .T.})
    aAdd(aPergs, {1, "Portador (vazio=todos)", Space(TamSX3("E1_PORTADO")[1])     , "@!", ".T.", "SA6", ".T.", 30, .F.})
    aAdd(aPergs, {1, "Agência (vazio=todas)", Space(TamSX3("E1_AGEDEP")[1])       , "@!", ".T.", ""   , ".T.", 40, .F.})
    aAdd(aPergs, {1, "Conta (vazio=todas)"  , Space(TamSX3("E1_CONTA")[1])        , "@!", ".T.", ""   , ".T.", 60, .F.})
    aAdd(aPergs, {1, "Borderô de"           , Space(nTamBor)                      , "@!", ".T.", ""   , ".T.", 40, .F.})
    aAdd(aPergs, {1, "Borderô até"          , Replicate("Z", nTamBor)             , "@!", ".T.", ""   , ".T.", 40, .T.})
    aAdd(aPergs, {1, "Lote de"              , Space(nTamLote)                     , "@!", ".T.", ""   , ".T.", 40, .F.})
    aAdd(aPergs, {1, "Lote até"             , Replicate("Z", nTamLote)            , "@!", ".T.", ""   , ".T.", 40, .T.})
    aAdd(aPergs, {2, "Situação"             , aSituacao[1]                        , aSituacao, 90, ".T.", .T.})
    aAdd(aPergs, {1, "Banco do risco sacado", Space(TamSX3("A6_COD")[1])          , "@!", ".T.", "SA6", ".T.", 30, .F.})

    If !ParamBox(aPergs, "Risco Sacado - Parâmetros", @aRet, , , , , , , RS_PARAM_LOAD, .T., .T.)
        Return {}
    EndIf

    aRet[PAR_SITUAC] := OpcaoCombo(aRet[PAR_SITUAC])
Return aRet

/*/{Protheus.doc} OpcaoCombo
Converte o retorno do combo do ParamBox ("n-Descrição" ou posição numérica) em número.
@type static function
@author bacoetrom
@since 13/10/2026
@param xOpcao, variant, retorno do combo
@return numeric, número da opção
/*/
Static Function OpcaoCombo(xOpcao as variant) as numeric
    Local nOpcao := 1 as numeric

    If ValType(xOpcao) == "N"
        nOpcao := xOpcao
    ElseIf ValType(xOpcao) == "C" .And. !Empty(xOpcao)
        nOpcao := Val(Left(xOpcao, 1))
    EndIf
Return nOpcao

/*/{Protheus.doc} MontaTela
Cria a tabela temporária, carrega os títulos e exibe o FWMarkBrowse.
@type static function
@author bacoetrom
@since 13/10/2026
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, .T. quando a tela foi exibida
/*/
Static Function MontaTela(aPar as array) as logical
    Local aSize  := {} as array
    Local cAlias := "" as character
    Local oTmp   as object
    Local oDlg   as object
    Local oMark  as object

    oTmp   := CriaTemporaria()
    cAlias := oTmp:GetAlias()

    FWMsgRun(, {|| CarregaTitulos(cAlias, aPar)}, RS_TITULO, "Selecionando títulos...")
    (cAlias)->(DbGoTop())
    If (cAlias)->(Eof())
        FWAlertWarning("Nenhum título encontrado para os parâmetros informados.", RS_TITULO)
        oTmp:Delete()
        Return .F.
    EndIf

    aSize := FWGetDialogSize(oMainWnd)
    oDlg  := MsDialog():New(aSize[1], aSize[2], aSize[3], aSize[4], RS_TITULO,,,,,,,,, .T.,,,, .F.)

    oMark := FWMarkBrowse():New()
    oMark:SetOwner(oDlg)
    oMark:SetDescription("Risco Sacado - Títulos a Receber")
    oMark:SetAlias(cAlias)
    oMark:SetFieldMark("TR_OK")
    oMark:SetTemporary(.T.)
    oMark:SetMenuDef("")
    oMark:DisableDetails()
    oMark:SetColumns(DefineColunas(cAlias))

    oMark:AddButton("Marcar Todos"     , {|| MarcaTodos(oMark, 1)})
    oMark:AddButton("Desmarcar Todos"  , {|| MarcaTodos(oMark, 2)})
    oMark:AddButton("Inverter Seleção" , {|| MarcaTodos(oMark, 3)})
    oMark:AddButton("Risco Sacado"     , {|| AcaoRiscoSacado(oMark, aPar)})
    oMark:AddButton("Não Pago ao Banco", {|| AcaoSituacao(oMark, aPar, RS_NAO_PAGO)})
    oMark:AddButton("Pago ao Banco"    , {|| AcaoSituacao(oMark, aPar, RS_PAGO)})
    oMark:AddButton("Estornar Situação", {|| AcaoSituacao(oMark, aPar, RS_ENVIADO)})
    oMark:AddButton("Excluir Lote"     , {|| AcaoExcluirLote(oMark, aPar)})
    oMark:AddButton("Sair"             , {|| oDlg:End()})

    // Clique no cabeçalho da coluna de marca inverte a seleção
    oMark:bAllMark := {|| MarcaTodos(oMark, 3)}

    oMark:Activate()
    oDlg:Activate()

    oMark:DeActivate()
    oTmp:Delete()
Return .T.

/*/{Protheus.doc} CriaTemporaria
Cria a tabela temporária do browse (FWTemporaryTable).
@type static function
@author bacoetrom
@since 13/10/2026
@return object, instância de FWTemporaryTable já criada
/*/
Static Function CriaTemporaria() as object
    Local aCampos := {} as array
    Local oTmp    as object

    aAdd(aCampos, {"TR_OK"    , "C", 2                        , 0})
    aAdd(aCampos, {"TR_FILIAL", "C", TamSX3("E1_FILIAL")[1]   , 0})
    aAdd(aCampos, {"TR_LOTE"  , "C", TamSX3("E1_XLOTRS")[1]   , 0})
    aAdd(aCampos, {"TR_RISCO" , "C", 1                        , 0})
    aAdd(aCampos, {"TR_STATUS", "C", 1                        , 0})
    aAdd(aCampos, {"TR_SITUAC", "C", 20                       , 0})
    aAdd(aCampos, {"TR_PREFIX", "C", TamSX3("E1_PREFIXO")[1]  , 0})
    aAdd(aCampos, {"TR_NUM"   , "C", TamSX3("E1_NUM")[1]      , 0})
    aAdd(aCampos, {"TR_PARCEL", "C", TamSX3("E1_PARCELA")[1]  , 0})
    aAdd(aCampos, {"TR_TIPO"  , "C", TamSX3("E1_TIPO")[1]     , 0})
    aAdd(aCampos, {"TR_CLIENT", "C", TamSX3("E1_CLIENTE")[1]  , 0})
    aAdd(aCampos, {"TR_LOJA"  , "C", TamSX3("E1_LOJA")[1]     , 0})
    aAdd(aCampos, {"TR_NOMCLI", "C", TamSX3("E1_NOMCLI")[1]   , 0})
    aAdd(aCampos, {"TR_EMISSA", "D", 8                        , 0})
    aAdd(aCampos, {"TR_VENCRE", "D", 8                        , 0})
    aAdd(aCampos, {"TR_VALOR" , "N", TamSX3("E1_VALOR")[1]    , TamSX3("E1_VALOR")[2]})
    aAdd(aCampos, {"TR_SALDO" , "N", TamSX3("E1_SALDO")[1]    , TamSX3("E1_SALDO")[2]})
    aAdd(aCampos, {"TR_PORTAD", "C", TamSX3("E1_PORTADO")[1]  , 0})
    aAdd(aCampos, {"TR_NUMBOR", "C", TamSX3("E1_NUMBOR")[1]   , 0})
    aAdd(aCampos, {"TR_XBANCO", "C", TamSX3("E1_XBANCO")[1]   , 0})
    aAdd(aCampos, {"TR_RECSE1", "N", 12                       , 0})

    oTmp := FWTemporaryTable():New(GetNextAlias())
    oTmp:SetFields(aCampos)
    oTmp:AddIndex("01", {"TR_FILIAL", "TR_LOTE", "TR_PREFIX", "TR_NUM", "TR_PARCEL", "TR_TIPO"})
    oTmp:Create()
Return oTmp

/*/{Protheus.doc} CarregaTitulos
Seleciona os títulos a receber conforme os parâmetros e grava na tabela temporária.
@type static function
@author bacoetrom
@since 13/10/2026
@param cAlias, character, alias da tabela temporária
@param aPar, array, respostas dos parâmetros (ParamBox)
@return numeric, quantidade de títulos carregados
/*/
Static Function CarregaTitulos(cAlias as character, aPar as array) as numeric
    Local aBind      := {} as array
    Local cQuery     := "" as character
    Local cAliasQry  := "" as character
    Local nI         := 0 as numeric
    Local nQtd       := 0 as numeric
    Local nSituac    := 0 as numeric
    Local oStatement as object

    nSituac := aPar[PAR_SITUAC]

    cQuery := "SELECT SE1.E1_FILIAL, SE1.E1_PREFIXO, SE1.E1_NUM, SE1.E1_PARCELA, SE1.E1_TIPO, "
    cQuery += "       SE1.E1_CLIENTE, SE1.E1_LOJA, SE1.E1_NOMCLI, SE1.E1_EMISSAO, SE1.E1_VENCREA, "
    cQuery += "       SE1.E1_VALOR, SE1.E1_SALDO, SE1.E1_PORTADO, SE1.E1_NUMBOR, "
    cQuery += "       SE1.E1_XBANCO, SE1.E1_XLOTRS, SE1.E1_XRISCO, SE1.E1_XSTRIC, SE1.R_E_C_N_O_ RECSE1 "
    cQuery += "  FROM " + RetSqlName("SE1") + " SE1 "
    cQuery += " WHERE SE1.D_E_L_E_T_ = ? "
    aAdd(aBind, " ")
    cQuery += "   AND SE1.E1_FILIAL BETWEEN ? AND ? "
    aAdd(aBind, aPar[PAR_FILDE])
    aAdd(aBind, aPar[PAR_FILATE])
    cQuery += "   AND SE1.E1_VENCREA BETWEEN ? AND ? "
    aAdd(aBind, DtoS(aPar[PAR_VENCDE]))
    aAdd(aBind, DtoS(aPar[PAR_VENCATE]))
    cQuery += "   AND SE1.E1_NUMBOR BETWEEN ? AND ? "
    aAdd(aBind, aPar[PAR_BORDE])
    aAdd(aBind, aPar[PAR_BORATE])
    cQuery += "   AND SE1.E1_XLOTRS BETWEEN ? AND ? "
    aAdd(aBind, aPar[PAR_LOTEDE])
    aAdd(aBind, aPar[PAR_LOTEATE])
    cQuery += "   AND SE1.E1_SALDO > 0 "
    // Exclui abatimentos (tipos com '-'), adiantamentos, créditos e provisórios
    cQuery += "   AND SUBSTRING(SE1.E1_TIPO, 3, 1) <> '-' "
    cQuery += "   AND SE1.E1_TIPO NOT IN ('RA ', 'NCC', 'PR ') "

    If !Empty(aPar[PAR_PORTADO])
        cQuery += "   AND SE1.E1_PORTADO = ? "
        aAdd(aBind, aPar[PAR_PORTADO])
    EndIf
    If !Empty(aPar[PAR_AGENCIA])
        cQuery += "   AND SE1.E1_AGEDEP = ? "
        aAdd(aBind, aPar[PAR_AGENCIA])
    EndIf
    If !Empty(aPar[PAR_CONTA])
        cQuery += "   AND SE1.E1_CONTA = ? "
        aAdd(aBind, aPar[PAR_CONTA])
    EndIf

    If nSituac == SIT_SEM_RISCO
        cQuery += "   AND (SE1.E1_XRISCO <> ?  OR RTRIM(SE1.E1_XRISCO) IS NULL) "
        aAdd(aBind, RS_RISCO_SIM)
    Else
        cQuery += "   AND SE1.E1_XRISCO = ? "
        aAdd(aBind, RS_RISCO_SIM)
        If nSituac == SIT_ENVIADO
            cQuery += "   AND SE1.E1_XSTRIC = ? "
            aAdd(aBind, RS_ENVIADO)
        ElseIf nSituac == SIT_NAO_PAGO
            cQuery += "   AND SE1.E1_XSTRIC = ? "
            aAdd(aBind, RS_NAO_PAGO)
        ElseIf nSituac == SIT_PAGO
            cQuery += "   AND SE1.E1_XSTRIC = ? "
            aAdd(aBind, RS_PAGO)
        EndIf
    EndIf

    cQuery += " ORDER BY SE1.E1_FILIAL, SE1.E1_XLOTRS, SE1.E1_VENCREA, SE1.E1_PREFIXO, SE1.E1_NUM, SE1.E1_PARCELA "

    oStatement := FWExecStatement():New(ChangeQuery(cQuery))
    For nI := 1 To Len(aBind)
        oStatement:SetString(nI, aBind[nI])
    Next nI
    cAliasQry := oStatement:OpenAlias(GetNextAlias())

    While !(cAliasQry)->(Eof())
        RecLock(cAlias, .T.)
        (cAlias)->TR_OK     := Space(2)
        (cAlias)->TR_FILIAL := (cAliasQry)->E1_FILIAL
        (cAlias)->TR_LOTE   := (cAliasQry)->E1_XLOTRS
        (cAlias)->TR_RISCO  := (cAliasQry)->E1_XRISCO
        (cAlias)->TR_STATUS := (cAliasQry)->E1_XSTRIC
        (cAlias)->TR_SITUAC := U_PXRSDescSituacao((cAliasQry)->E1_XRISCO, (cAliasQry)->E1_XSTRIC)
        (cAlias)->TR_PREFIX := (cAliasQry)->E1_PREFIXO
        (cAlias)->TR_NUM    := (cAliasQry)->E1_NUM
        (cAlias)->TR_PARCEL := (cAliasQry)->E1_PARCELA
        (cAlias)->TR_TIPO   := (cAliasQry)->E1_TIPO
        (cAlias)->TR_CLIENT := (cAliasQry)->E1_CLIENTE
        (cAlias)->TR_LOJA   := (cAliasQry)->E1_LOJA
        (cAlias)->TR_NOMCLI := (cAliasQry)->E1_NOMCLI
        (cAlias)->TR_EMISSA := StoD((cAliasQry)->E1_EMISSAO)
        (cAlias)->TR_VENCRE := StoD((cAliasQry)->E1_VENCREA)
        (cAlias)->TR_VALOR  := (cAliasQry)->E1_VALOR
        (cAlias)->TR_SALDO  := (cAliasQry)->E1_SALDO
        (cAlias)->TR_PORTAD := (cAliasQry)->E1_PORTADO
        (cAlias)->TR_NUMBOR := (cAliasQry)->E1_NUMBOR
        (cAlias)->TR_XBANCO := (cAliasQry)->E1_XBANCO
        (cAlias)->TR_RECSE1 := (cAliasQry)->RECSE1
        (cAlias)->(MsUnlock())
        nQtd++
        (cAliasQry)->(DbSkip())
    EndDo

    (cAliasQry)->(DbCloseArea())
    oStatement:Destroy()
    oStatement := Nil
Return nQtd

/*/{Protheus.doc} DefineColunas
Monta as colunas do FWMarkBrowse.
@type static function
@author bacoetrom
@since 13/10/2026
@param cAlias, character, alias da tabela temporária
@return array, colunas no formato aceito por SetColumns
/*/
Static Function DefineColunas(cAlias as character) as array
    Local aColunas := {} as array
    Local aDef     := {} as array
    Local nI       := 0 as numeric
    Local bDado    as codeblock

    // {Campo, Título, Picture, Tamanho, Decimais, Alinhamento (0=Centro;1=Esquerda;2=Direita)}
    aAdd(aDef, {"TR_FILIAL", "Filial"      , "@!"                  , TamSX3("E1_FILIAL")[1]  , 0                     , 1})
    aAdd(aDef, {"TR_LOTE"  , "Lote"        , "@!"                  , TamSX3("E1_XLOTRS")[1]  , 0                     , 1})
    aAdd(aDef, {"TR_SITUAC", "Situação"    , "@!"                  , 20                      , 0                     , 1})
    aAdd(aDef, {"TR_PREFIX", "Prefixo"     , "@!"                  , TamSX3("E1_PREFIXO")[1] , 0                     , 1})
    aAdd(aDef, {"TR_NUM"   , "Número"      , "@!"                  , TamSX3("E1_NUM")[1]     , 0                     , 1})
    aAdd(aDef, {"TR_PARCEL", "Parcela"     , "@!"                  , TamSX3("E1_PARCELA")[1] , 0                     , 1})
    aAdd(aDef, {"TR_TIPO"  , "Tipo"        , "@!"                  , TamSX3("E1_TIPO")[1]    , 0                     , 1})
    aAdd(aDef, {"TR_CLIENT", "Cliente"     , "@!"                  , TamSX3("E1_CLIENTE")[1] , 0                     , 1})
    aAdd(aDef, {"TR_LOJA"  , "Loja"        , "@!"                  , TamSX3("E1_LOJA")[1]    , 0                     , 1})
    aAdd(aDef, {"TR_NOMCLI", "Nome"        , "@!"                  , TamSX3("E1_NOMCLI")[1]  , 0                     , 1})
    aAdd(aDef, {"TR_EMISSA", "Emissão"     , ""                    , 10                      , 0                     , 0})
    aAdd(aDef, {"TR_VENCRE", "Vencto Real" , ""                    , 10                      , 0                     , 0})
    aAdd(aDef, {"TR_VALOR" , "Valor"       , X3Picture("E1_VALOR") , TamSX3("E1_VALOR")[1]   , TamSX3("E1_VALOR")[2] , 2})
    aAdd(aDef, {"TR_SALDO" , "Saldo"       , X3Picture("E1_SALDO") , TamSX3("E1_SALDO")[1]   , TamSX3("E1_SALDO")[2] , 2})
    aAdd(aDef, {"TR_PORTAD", "Portador"    , "@!"                  , TamSX3("E1_PORTADO")[1] , 0                     , 1})
    aAdd(aDef, {"TR_NUMBOR", "Borderô"     , "@!"                  , TamSX3("E1_NUMBOR")[1]  , 0                     , 1})
    aAdd(aDef, {"TR_XBANCO", "Banco Risco" , "@!"                  , TamSX3("E1_XBANCO")[1]  , 0                     , 1})

    For nI := 1 To Len(aDef)
        bDado := &("{|| ('" + cAlias + "')->" + aDef[nI][1] + "}")
        // Estrutura da coluna: título, bloco de dados, tipo, máscara, alinhamento, tamanho, decimal,
        // edita, bValid, imagem, bDuploClique, ReadVar, bHeaderClick, deletada, detalhe, opções
        aAdd(aColunas, {aDef[nI][2], bDado, Nil, aDef[nI][3], aDef[nI][6], aDef[nI][4], aDef[nI][5], ;
                        .F., {|| .T.}, .F., {|| .T.}, Nil, {|| .T.}, .F., .F., {}})
    Next nI
Return aColunas

/*/{Protheus.doc} MarcaTodos
Marca, desmarca ou inverte a seleção de todos os registros do browse.
@type static function
@author bacoetrom
@since 13/10/2026
@param oMark, object, FWMarkBrowse
@param nModo, numeric, 1=Marcar todos; 2=Desmarcar todos; 3=Inverter
@return logical, sempre .T.
/*/
Static Function MarcaTodos(oMark as object, nModo as numeric) as logical
    Local cAlias := oMark:Alias() as character
    Local cMarca := oMark:Mark() as character
    Local nRecno := (cAlias)->(Recno()) as numeric

    (cAlias)->(DbGoTop())
    While !(cAlias)->(Eof())
        RecLock(cAlias, .F.)
        If nModo == 1
            (cAlias)->TR_OK := cMarca
        ElseIf nModo == 2
            (cAlias)->TR_OK := Space(2)
        ElseIf (cAlias)->TR_OK == cMarca
            (cAlias)->TR_OK := Space(2)
        Else
            (cAlias)->TR_OK := cMarca
        EndIf
        (cAlias)->(MsUnlock())
        (cAlias)->(DbSkip())
    EndDo

    (cAlias)->(DbGoTo(nRecno))
    oMark:Refresh(.T.)
Return .T.

/*/{Protheus.doc} ColetaMarcados
Retorna os títulos marcados no browse.
@type static function
@author bacoetrom
@since 13/10/2026
@param oMark, object, FWMarkBrowse
@return array, {{nRecSE1, cFilTit, cLote, cRisco}, ...}
/*/
Static Function ColetaMarcados(oMark as object) as array
    Local aSel   := {} as array
    Local cAlias := oMark:Alias() as character
    Local cMarca := oMark:Mark() as character
    Local nRecno := (cAlias)->(Recno()) as numeric

    (cAlias)->(DbGoTop())
    While !(cAlias)->(Eof())
        If (cAlias)->TR_OK == cMarca
            aAdd(aSel, {(cAlias)->TR_RECSE1, (cAlias)->TR_FILIAL, (cAlias)->TR_LOTE, (cAlias)->TR_RISCO})
        EndIf
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbGoTo(nRecno))
Return aSel

/*/{Protheus.doc} AcaoRiscoSacado
Ação "Risco Sacado": envia os títulos marcados ao banco, gerando um lote por filial.
@type static function
@author bacoetrom
@since 13/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, .T. quando processado
/*/
Static Function AcaoRiscoSacado(oMark as object, aPar as array) as logical
    Local aSel     := {} as array
    Local aFiliais := {} as array
    Local aForn    := {} as array
    Local aLog     := {} as array
    Local cBanco   := "" as character
    Local cFilTit  := "" as character
    Local nI       := 0 as numeric
    Local nPos     := 0 as numeric

    cBanco := aPar[PAR_BCORS]
    If Empty(cBanco)
        FWAlertWarning("Informe o banco do risco sacado no parâmetro 'Banco do risco sacado.'", RS_TITULO)
        Return .F.
    EndIf

    aSel := ColetaMarcados(oMark)
    If Empty(aSel)
        FWAlertWarning("Nenhum título marcado.", RS_TITULO)
        Return .F.
    EndIf

    If !MsgYesNo("Confirma o envio de " + cValToChar(Len(aSel)) + " título(s) em Risco Sacado para o banco " + ;
                 AllTrim(cBanco) + "?" + CRLF + "Será gerado um lote por filial.", RS_TITULO)
        Return .F.
    EndIf

    // Agrupa os títulos por filial (um lote por filial)
    For nI := 1 To Len(aSel)
        If aSel[nI][MRK_RISCO] == RS_RISCO_SIM
            aAdd(aLog, "Filial " + AllTrim(aSel[nI][MRK_FILIAL]) + " recno " + cValToChar(aSel[nI][MRK_RECNO]) + ;
                       ": título já está em risco sacado (lote " + AllTrim(aSel[nI][MRK_LOTE]) + ").")
            Loop
        EndIf
        nPos := aScan(aFiliais, {|x| x[1] == aSel[nI][MRK_FILIAL]})
        If nPos == 0
            aAdd(aFiliais, {aSel[nI][MRK_FILIAL], {}})
            nPos := Len(aFiliais)
        EndIf
        aAdd(aFiliais[nPos][2], aSel[nI][MRK_RECNO])
    Next nI

    SA2->(DbSetOrder(1)) // A2_FILIAL+A2_COD+A2_LOJA
    For nI := 1 To Len(aFiliais)
        cFilTit := aFiliais[nI][1]
        aForn   := U_PXRSFornBanco(cFilTit, cBanco)
        If Empty(aForn[1])
            aAdd(aLog, "Filial " + AllTrim(cFilTit) + ": banco " + AllTrim(cBanco) + ;
                       " sem fornecedor (A6_XFORN/A6_XLOJA) informado. Títulos não processados.")
        ElseIf !SA2->(DbSeek(xFilial("SA2", cFilTit) + aForn[1] + aForn[2]))
            aAdd(aLog, "Filial " + AllTrim(cFilTit) + ": fornecedor " + AllTrim(aForn[1]) + "/" + AllTrim(aForn[2]) + ;
                       " do banco não cadastrado. Títulos não processados.")
        Else
            ProcessaLote(cFilTit, cBanco, aFiliais[nI][2], aLog)
        EndIf
    Next nI

    MostraLog(aLog)
    Recarrega(oMark, aPar)
Return .T.

/*/{Protheus.doc} ProcessaLote
Gera o lote de risco sacado de uma filial e marca os títulos.
@type static function
@author bacoetrom
@since 13/10/2026
@param cFilTit, character, filial dos títulos
@param cBanco, character, banco do risco sacado
@param aRecnos, array, R_E_C_N_O_ dos títulos da filial
@param aLog, array, log de processamento (por referência)
@return logical, .T. quando ao menos um título foi gravado
/*/
Static Function ProcessaLote(cFilTit as character, cBanco as character, aRecnos as array, aLog as array) as logical
    Local cLote := "" as character
    Local nI    := 0 as numeric
    Local nOk   := 0 as numeric

    cLote := ProximoLote(cFilTit)

    Begin Transaction
        For nI := 1 To Len(aRecnos)
            SE1->(DbGoTo(aRecnos[nI]))
            If SE1->(Eof()) .Or. SE1->E1_XRISCO == RS_RISCO_SIM .Or. SE1->E1_SALDO <= 0
                aAdd(aLog, ChaveTitulo() + ": título alterado por outro processo, não incluído no lote.")
                Loop
            EndIf
            RecLock("SE1", .F.)
            SE1->E1_XLOTRS  := cLote
            SE1->E1_XBANCO  := cBanco
            SE1->E1_XRISCO  := RS_RISCO_SIM
            SE1->E1_XDTRISC := dDataBase
            SE1->E1_XSTRIC  := RS_ENVIADO
            SE1->(MsUnlock())
            nOk++
        Next nI
    End Transaction

    If nOk > 0
        ConfirmSX8()
        aAdd(aLog, "Filial " + AllTrim(cFilTit) + ": lote " + cLote + " gerado com " + cValToChar(nOk) + " título(s).")
        U_PXRSLog("INFO", "Lote de risco sacado " + cLote + " filial " + AllTrim(cFilTit) + " banco " + AllTrim(cBanco) + ;
                          " - " + cValToChar(nOk) + " título(s) - usuário " + AllTrim(UsrRetName(RetCodUsr())))
    Else
        RollBackSX8()
    EndIf
Return nOk > 0

/*/{Protheus.doc} ProximoLote
Obtém o próximo código de lote (6 dígitos) garantindo que não exista na filial.
@type static function
@author bacoetrom
@since 13/10/2026
@param cFilTit, character, filial dos títulos
@return character, código do lote
/*/
Static Function ProximoLote(cFilTit as character) as character
    Local cLote := "" as character

    cLote := GetSXENum("SE1", "E1_XLOTRS")
    While LoteExiste(cFilTit, cLote)
        ConfirmSX8()
        cLote := GetSXENum("SE1", "E1_XLOTRS")
    EndDo
Return cLote

/*/{Protheus.doc} LoteExiste
Verifica se o código de lote já foi usado na filial.
@type static function
@author bacoetrom
@since 13/10/2026
@param cFilTit, character, filial
@param cLote, character, código do lote
@return logical, .T. quando já existe
/*/
Static Function LoteExiste(cFilTit as character, cLote as character) as logical
    Local cQuery     := "" as character
    Local xQtd       as variant
    Local oStatement as object

    cQuery := "SELECT COUNT(*) QTD "
    cQuery += "  FROM " + RetSqlName("SE1") + " SE1 "
    cQuery += " WHERE SE1.D_E_L_E_T_ = ? "
    cQuery += "   AND SE1.E1_FILIAL = ? "
    cQuery += "   AND SE1.E1_XLOTRS = ? "

    oStatement := FWExecStatement():New(ChangeQuery(cQuery))
    oStatement:SetString(1, " ")
    oStatement:SetString(2, cFilTit)
    oStatement:SetString(3, cLote)
    xQtd := oStatement:ExecScalar("QTD")
    oStatement:Destroy()
    oStatement := Nil
Return ValType(xQtd) == "N" .And. xQtd > 0

/*/{Protheus.doc} AcaoSituacao
Altera a situação de risco sacado dos títulos marcados.
  RS_NAO_PAGO / RS_PAGO : a partir de "Enviado ao Banco".
  RS_ENVIADO (estorno)  : a partir de "Não pago" ou "Pago", sem baixa após o envio e sem SE2 gerado.
@type static function
@author bacoetrom
@since 13/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@param cNovo, character, nova situação
@return logical, .T. quando processado
/*/
Static Function AcaoSituacao(oMark as object, aPar as array, cNovo as character) as logical
    Local aSel     := {} as array
    Local aLog     := {} as array
    Local aOrigem  := {} as array
    Local cAcao    := "" as character
    Local cMotivo  := "" as character
    Local nI       := 0 as numeric
    Local nOk      := 0 as numeric

    If cNovo == RS_ENVIADO
        aOrigem := {RS_NAO_PAGO, RS_PAGO}
        cAcao   := "Estornar Situação (voltar para 'Enviado ao Banco')"
    ElseIf cNovo == RS_NAO_PAGO
        aOrigem := {RS_ENVIADO}
        cAcao   := "Não Pago ao Banco"
    Else
        aOrigem := {RS_ENVIADO}
        cAcao   := "Pago ao Banco"
    EndIf

    aSel := ColetaMarcados(oMark)
    If Empty(aSel)
        FWAlertWarning("Nenhum título marcado.", RS_TITULO)
        Return .F.
    EndIf

    If !MsgYesNo("Confirma '" + cAcao + "' para " + cValToChar(Len(aSel)) + " título(s)?", RS_TITULO)
        Return .F.
    EndIf

    Begin Transaction
        For nI := 1 To Len(aSel)
            SE1->(DbGoTo(aSel[nI][MRK_RECNO]))
            cMotivo := ValidaSituacao(aOrigem, cNovo)
            If !Empty(cMotivo)
                aAdd(aLog, ChaveTitulo() + ": " + cMotivo)
                Loop
            EndIf
            RecLock("SE1", .F.)
            SE1->E1_XSTRIC := cNovo
            SE1->(MsUnlock())
            nOk++
        Next nI
    End Transaction

    aAdd(aLog, cAcao + ": " + cValToChar(nOk) + " título(s) atualizado(s).")
    U_PXRSLog("INFO", cAcao + ": " + cValToChar(nOk) + " título(s) - usuário " + AllTrim(UsrRetName(RetCodUsr())))
    MostraLog(aLog)
    Recarrega(oMark, aPar)
Return .T.

/*/{Protheus.doc} ValidaSituacao
Valida a mudança de situação do título posicionado na SE1.
@type static function
@author bacoetrom
@since 13/10/2026
@param aOrigem, array, situações de origem permitidas
@param cNovo, character, nova situação
@return character, motivo da rejeição ou vazio quando permitido
/*/
Static Function ValidaSituacao(aOrigem as array, cNovo as character) as character
    Local cMotivo := "" as character

    If SE1->(Eof()) .Or. SE1->E1_XRISCO <> RS_RISCO_SIM
        cMotivo := "título não está em risco sacado."
    ElseIf aScan(aOrigem, SE1->E1_XSTRIC) == 0
        cMotivo := "situação atual '" + U_PXRSDescSituacao(SE1->E1_XRISCO, SE1->E1_XSTRIC) + "' não permite esta operação."
    ElseIf SE1->E1_SALDO <= 0
        cMotivo := "título já baixado."
    ElseIf cNovo == RS_ENVIADO .And. !Empty(SE1->E1_BAIXA) .And. SE1->E1_BAIXA >= SE1->E1_XDTRISC
        cMotivo := "título possui baixa após o envio ao banco."
    ElseIf cNovo == RS_ENVIADO .And. SE1->E1_XSTRIC == RS_NAO_PAGO .And. ;
           U_PXRSBuscaPagar(SE1->E1_FILIAL, U_PXRSChaveOrigem()) > 0
        cMotivo := "já existe título a pagar de risco sacado gerado."
    EndIf
Return cMotivo

/*/{Protheus.doc} AcaoExcluirLote
Exclui os lotes dos títulos marcados, devolvendo todos os títulos do lote para "sem risco".
Permitido somente se nenhum título do lote tiver baixa após o envio ou SE2 gerado.
@type static function
@author bacoetrom
@since 13/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, .T. quando processado
/*/
Static Function AcaoExcluirLote(oMark as object, aPar as array) as logical
    Local aSel    := {} as array
    Local aLotes  := {} as array
    Local aLog    := {} as array
    Local aRecnos := {} as array
    Local cLotes  := "" as character
    Local cMotivo := "" as character
    Local nI      := 0 as numeric
    Local nJ      := 0 as numeric

    aSel := ColetaMarcados(oMark)
    For nI := 1 To Len(aSel)
        If !Empty(aSel[nI][MRK_LOTE]) .And. ;
           aScan(aLotes, {|x| x[1] == aSel[nI][MRK_FILIAL] .And. x[2] == aSel[nI][MRK_LOTE]}) == 0
            aAdd(aLotes, {aSel[nI][MRK_FILIAL], aSel[nI][MRK_LOTE]})
            cLotes += CRLF + "Filial " + AllTrim(aSel[nI][MRK_FILIAL]) + " - lote " + aSel[nI][MRK_LOTE]
        EndIf
    Next nI

    If Empty(aLotes)
        FWAlertWarning("Nenhum título marcado pertence a um lote de risco sacado.", RS_TITULO)
        Return .F.
    EndIf

    If !MsgYesNo("Confirma a exclusão do(s) lote(s) abaixo? Todos os títulos do lote voltarão para 'Sem risco'." + cLotes, RS_TITULO)
        Return .F.
    EndIf

    For nI := 1 To Len(aLotes)
        aRecnos := TitulosDoLote(aLotes[nI][1], aLotes[nI][2])
        cMotivo := ""
        For nJ := 1 To Len(aRecnos)
            SE1->(DbGoTo(aRecnos[nJ]))
            If SE1->E1_SALDO <= 0 .Or. (!Empty(SE1->E1_BAIXA) .And. SE1->E1_BAIXA >= SE1->E1_XDTRISC)
                cMotivo := ChaveTitulo() + " possui baixa após o envio ao banco."
                Exit
            ElseIf SE1->E1_XSTRIC == RS_NAO_PAGO .And. U_PXRSBuscaPagar(SE1->E1_FILIAL, U_PXRSChaveOrigem()) > 0
                cMotivo := ChaveTitulo() + " possui título a pagar de risco sacado gerado."
                Exit
            EndIf
        Next nJ

        If !Empty(cMotivo)
            aAdd(aLog, "Lote " + aLotes[nI][2] + " (filial " + AllTrim(aLotes[nI][1]) + ") não excluído: " + cMotivo)
            Loop
        EndIf

        Begin Transaction
            For nJ := 1 To Len(aRecnos)
                SE1->(DbGoTo(aRecnos[nJ]))
                RecLock("SE1", .F.)
                SE1->E1_XLOTRS  := Space(TamSX3("E1_XLOTRS")[1])
                SE1->E1_XBANCO  := Space(TamSX3("E1_XBANCO")[1])
                SE1->E1_XDTRISC := CtoD("")
                SE1->E1_XSTRIC  := Space(TamSX3("E1_XSTRIC")[1])
                SE1->E1_XRISCO  := RS_RISCO_NAO
                SE1->(MsUnlock())
            Next nJ
        End Transaction

        aAdd(aLog, "Lote " + aLotes[nI][2] + " (filial " + AllTrim(aLotes[nI][1]) + ") excluído: " + ;
                   cValToChar(Len(aRecnos)) + " título(s) devolvido(s) para 'Sem risco'.")
        U_PXRSLog("INFO", "Lote " + aLotes[nI][2] + " filial " + AllTrim(aLotes[nI][1]) + " excluído - usuário " + ;
                          AllTrim(UsrRetName(RetCodUsr())))
    Next nI

    MostraLog(aLog)
    Recarrega(oMark, aPar)
Return .T.

/*/{Protheus.doc} TitulosDoLote
Retorna os R_E_C_N_O_ de todos os títulos de um lote.
@type static function
@author bacoetrom
@since 13/10/2026
@param cFilTit, character, filial
@param cLote, character, código do lote
@return array, R_E_C_N_O_ da SE1
/*/
Static Function TitulosDoLote(cFilTit as character, cLote as character) as array
    Local aRecnos    := {} as array
    Local cQuery     := "" as character
    Local cAliasQry  := "" as character
    Local oStatement as object

    cQuery := "SELECT SE1.R_E_C_N_O_ RECSE1 "
    cQuery += "  FROM " + RetSqlName("SE1") + " SE1 "
    cQuery += " WHERE SE1.D_E_L_E_T_ = ? "
    cQuery += "   AND SE1.E1_FILIAL = ? "
    cQuery += "   AND SE1.E1_XLOTRS = ? "

    oStatement := FWExecStatement():New(ChangeQuery(cQuery))
    oStatement:SetString(1, " ")
    oStatement:SetString(2, cFilTit)
    oStatement:SetString(3, cLote)
    cAliasQry := oStatement:OpenAlias(GetNextAlias())

    While !(cAliasQry)->(Eof())
        aAdd(aRecnos, (cAliasQry)->RECSE1)
        (cAliasQry)->(DbSkip())
    EndDo

    (cAliasQry)->(DbCloseArea())
    oStatement:Destroy()
    oStatement := Nil
Return aRecnos

/*/{Protheus.doc} Recarrega
Recarrega a tabela temporária após uma ação e atualiza o browse.
@type static function
@author bacoetrom
@since 13/10/2026
@param oMark, object, FWMarkBrowse
@param aPar, array, respostas dos parâmetros (ParamBox)
@return logical, sempre .T.
/*/
Static Function Recarrega(oMark as object, aPar as array) as logical
    Local cAlias := oMark:Alias() as character

    (cAlias)->(DbGoTop())
    While !(cAlias)->(Eof())
        RecLock(cAlias, .F.)
        (cAlias)->(DbDelete())
        (cAlias)->(MsUnlock())
        (cAlias)->(DbSkip())
    EndDo

    FWMsgRun(, {|| CarregaTitulos(cAlias, aPar)}, RS_TITULO, "Atualizando títulos...")
    (cAlias)->(DbGoTop())
    oMark:Refresh(.T.)
Return .T.

/*/{Protheus.doc} ChaveTitulo
Identificação do título posicionado na SE1 para mensagens.
@type static function
@author bacoetrom
@since 13/10/2026
@return character, filial/prefixo/número/parcela/tipo
/*/
Static Function ChaveTitulo() as character
Return "Título " + AllTrim(SE1->E1_FILIAL) + "/" + AllTrim(SE1->E1_PREFIXO) + "/" + AllTrim(SE1->E1_NUM) + ;
       "/" + AllTrim(SE1->E1_PARCELA) + "/" + AllTrim(SE1->E1_TIPO)

/*/{Protheus.doc} MostraLog
Exibe o resumo do processamento (limitado a RS_MAX_LOG linhas; todas vão para o log do servidor).
@type static function
@author bacoetrom
@since 13/10/2026
@param aLog, array, mensagens
@return logical, sempre .T.
/*/
Static Function MostraLog(aLog as array) as logical
    Local cTexto := "" as character
    Local nI     := 0 as numeric

    If Empty(aLog)
        Return .T.
    EndIf

    For nI := 1 To Len(aLog)
        U_PXRSLog("INFO", aLog[nI])
        If nI <= RS_MAX_LOG
            cTexto += aLog[nI] + CRLF
        EndIf
    Next nI

    If Len(aLog) > RS_MAX_LOG
        cTexto += "... e mais " + cValToChar(Len(aLog) - RS_MAX_LOG) + " mensagem(ns). Consulte o log do servidor (RISCOSACADO)."
    EndIf

    FWAlertInfo(cTexto, RS_TITULO)
Return .T.
