#include "tlpp-core.th"
#include "totvs.ch"
#include "fwmvcdef.ch"

#define RS_RISCO_SIM   "S"
#define RS_ENVIADO     "1"
#define RS_NAO_PAGO    "2"
#define RS_TOLERANCIA  0.0049
#define RS_OPER_BAIXA  "B"
#define RS_OPER_ESTOR  "E"

/*/{Protheus.doc} FINM010
Ponto de entrada MVC do modelo de Baixa a Receber (FINM010 - tabela FK1).
Usado por todas as rotinas que gravam baixa a receber (FINA070, FINA110, FINA200...).

Risco Sacado:
  MODELPOS        - bloqueia a baixa de título "Enviado ao Banco" (E1_XSTRIC = 1);
                    pré-valida a geração do SE2 (status 2) e o estorno (SE2 já pago/em borderô).
  MODELCOMMITTTS  - dentro da transação: gera o SE2 na baixa NOR que liquida título com status 2;
                    exclui o SE2 no cancelamento. Em caso de falha, desarma a transação (desfaz a baixa).

Estrutura do modelo padrão: MASTER (falso) -> FKADETAIL (grid) -> FK1DETAIL (grid).
Por isso os dados da FK1 são lidos uma única vez, percorrendo as linhas da FKA (LeDadosBaixa),
e não pela linha que estiver ativa no momento da chamada.
O FINA070 grava o modelo uma vez por movimento (SE5) no cancelamento, então o ponto é chamado
várias vezes na mesma operação: o tratamento precisa ser idempotente.

PARAMIXB:
  [1] Object    - modelo (ou submodelo, conforme o ID)
  [2] Character - ID do ponto de execução
  [3] Character - ID do formulário

@type user function
@author bacoetrom
@since 13/10/2026
@return variant, lógico nos IDs de validação
@obs Ver plano __Risco_Sacado/PLANO_RISCO_SACADO.md - itens VAL-001 a VAL-006 devem ser validados em debug.
@see https://tdn.totvs.com/pages/viewpage.action?pageId=284859148
/*/
User Function FINM010() as variant
    Local aParam   := PARAMIXB as variant
    Local xRet     := .T. as variant
    Local cIdPonto := "" as character
    Local oModel   as object
    Local oErro    as object
    Local jDados   as json

    If ValType(aParam) <> "A" .Or. Len(aParam) < 2
        Return xRet
    EndIf

    oModel   := aParam[1]
    cIdPonto := aParam[2]

    If cIdPonto <> "MODELPOS" .And. cIdPonto <> "MODELCOMMITTTS"
        Return xRet
    EndIf

    Try
        jDados := LeDadosBaixa(oModel)

        If U_PXRSLogAtivo()
            LogDiagnostico(oModel, cIdPonto, jDados)
        EndIf

        If cIdPonto == "MODELPOS"
            xRet := ValidaModelo(oModel, jDados)
        Else
           xRet := ProcessaCommit(oModel, jDados)
        EndIf
    Catch oErro
        // Erro inesperado: no MODELPOS bloqueia a baixa com a mensagem (não deixa seguir para o commit);
        // no commit desfaz a transação
        U_PXRSLog("ERROR", "FINM010/" + cIdPonto + ": " + oErro:Description)
        oModel:SetErrorMessage("FK1DETAIL", "", "FK1DETAIL", "", "PXRISCOSAC", ;
                               "Risco Sacado: " + oErro:Description, "Verifique o dicionário/cadastros do risco sacado e repita.")
        If cIdPonto == "MODELPOS"
            xRet := .F.
        Else
            DisarmTransaction()
        EndIf
    EndTry
Return xRet

/*/{Protheus.doc} ValidaModelo
Validação total do modelo da baixa (MODELPOS).
@type static function
@author bacoetrom
@since 13/10/2026
@param oModel, object, modelo FINM010
@param jDados, json, dados da baixa lidos por LeDadosBaixa
@return logical, .F. bloqueia a baixa/cancelamento
/*/
Static Function ValidaModelo(oModel as object, jDados as json) as logical
    Local aAreaSE1 := SE1->(GetArea()) as array
    Local lRet     := .T. as logical
    Local cOper    := "" as character
    Local cChave   := "" as character
    Local cMsg     := "" as character
    Local cSolucao := "" as character

    cOper := jDados["oper"]
    If Empty(cOper) .Or. !PosicionaTitulo(jDados["iddoc"]) .Or. SE1->E1_XRISCO <> RS_RISCO_SIM
        RestArea(aAreaSE1)
        Return lRet
    EndIf

    cChave := U_PXRSChaveOrigem()

    If cOper == RS_OPER_BAIXA
        If SE1->E1_XSTRIC == RS_ENVIADO
            cMsg     := "Título " + AllTrim(SE1->(E1_PREFIXO + "/" + E1_NUM + "/" + E1_PARCELA)) + ;
                        " está em Risco Sacado - Enviado ao Banco (lote " + AllTrim(SE1->E1_XLOTRS) + ")."
            cSolucao := "Informe a situação 'Pago ao Banco' ou 'Não pago ao Banco' na rotina PXFINA37 antes de baixar."
        ElseIf SE1->E1_XSTRIC == RS_NAO_PAGO .And. jDados["motbx"] == "NOR" .And. ;
               U_PXRSBuscaPagar(SE1->E1_FILIAL, cChave) == 0
            // SE2 já existente = gerado por um commit anterior da mesma operação: não bloqueia
            cMsg     := U_PXRSValidaGeracao(SE1->(Recno()))
            cSolucao := "Corrija o cadastro indicado e repita a baixa."
        EndIf
    ElseIf cOper == RS_OPER_ESTOR .And. SE1->E1_XSTRIC == RS_NAO_PAGO
        cMsg     := U_PXRSValidaEstorno(SE1->E1_FILIAL, cChave)
        cSolucao := "Regularize o título a pagar do risco sacado e repita o cancelamento."
    EndIf

    If !Empty(cMsg)
        lRet := .F.
        oModel:SetErrorMessage("FK1DETAIL", "", "FK1DETAIL", "", "PXRISCOSAC", cMsg, cSolucao)
        U_PXRSLog("WARN", "Bloqueio FINM010: " + cMsg)
    EndIf

    RestArea(aAreaSE1)
Return lRet

/*/{Protheus.doc} ProcessaCommit
Gravação dentro da transação (MODELCOMMITTTS): gera ou exclui o SE2 do risco sacado.
Idempotente: pode ser chamado mais de uma vez na mesma operação (um commit por movimento).
Em caso de falha desarma a transação, desfazendo a baixa/cancelamento.
@type static function
@author bacoetrom
@since 13/10/2026
@param oModel, object, modelo FINM010
@param jDados, json, dados da baixa lidos por LeDadosBaixa
@return logical, .T. quando processado sem erro
/*/
Static Function ProcessaCommit(oModel as object, jDados as json) as logical
    Local aAreaSE1 := SE1->(GetArea()) as array
    Local lRet     := .T. as logical
    Local cOper    := "" as character
    Local cChave   := "" as character
    Local cMsg     := "" as character
    Local nRecSE2  := 0 as numeric

    cOper := jDados["oper"]
    If Empty(cOper) .Or. !PosicionaTitulo(jDados["iddoc"]) .Or. SE1->E1_XRISCO <> RS_RISCO_SIM .Or. SE1->E1_XSTRIC <> RS_NAO_PAGO
        RestArea(aAreaSE1)
        Return lRet
    EndIf

    cChave  := U_PXRSChaveOrigem()
    nRecSE2 := U_PXRSBuscaPagar(SE1->E1_FILIAL, cChave)

    If cOper == RS_OPER_BAIXA
        // Valor total: gera somente na baixa que liquida o título (VAL-003: SE1 já atualizado neste ponto)
        If jDados["motbx"] == "NOR" //.And. SE1->E1_SALDO <= RS_TOLERANCIA
            If nRecSE2 == 0
                cMsg := U_PXRSGeraPagar(SE1->(Recno()))
            Else
                U_PXRSLog("INFO", "FINM010: SE2 do risco sacado já gerado para " + AllTrim(cChave) + " - commit ignorado.")
            EndIf
        EndIf
    ElseIf cOper == RS_OPER_ESTOR .And. nRecSE2 > 0
        cMsg := U_PXRSValidaEstorno(SE1->E1_FILIAL, cChave)
        If Empty(cMsg)
            cMsg := U_PXRSExcluiPagar(nRecSE2)
        EndIf
    EndIf

    If !Empty(cMsg)
        lRet := .F.
        DisarmTransaction()
        oModel:SetErrorMessage("FK1DETAIL", "", "FK1DETAIL", "", "PXRISCOSAC", cMsg, "A operação foi desfeita. Corrija o problema e repita.")
        U_PXRSLog("ERROR", "FINM010 commit desfeito: " + cMsg)
    EndIf

    RestArea(aAreaSE1)
Return lRet

/*/{Protheus.doc} LeDadosBaixa
Lê uma única vez os dados da baixa no modelo.
O FK1DETAIL é grid filha do FKADETAIL: a linha ativa pode ser de um movimento sem FK1 (FK5)
ou de um estorno (ES) recém-incluído, o que fazia o GetValue direto retornar vazio.
Aqui as linhas da FKA são percorridas até achar o registro principal da baixa (FK1_TPDOC VL/BA),
e o posicionamento das grids é restaurado ao final.
Operação: INSERT = baixa; DELETE ou UPDATE com MASTER/E5_OPERACAO (1=cancela, 2=estorna, 3=exclui) = estorno.
@type static function
@author bacoetrom
@since 15/10/2026
@param oModel, object, modelo FINM010
@return json, {oper, tpdoc, motbx, iddoc, valor}; oper vazio quando a operação não é tratada
/*/
Static Function LeDadosBaixa(oModel as object) as json
    Local jDados    := JsonObject():New() as json
    Local lAchou    := .F. as logical
    Local cTpDoc    := "" as character
    Local nOper     := 0 as numeric
    Local nOperSE5  := 0 as numeric
    Local nLinFKA   := 0 as numeric
    Local nLinFK1   := 0 as numeric
    Local nI        := 0 as numeric
    Local nJ        := 0 as numeric
    Local xOperSE5  as variant
    Local oFKA      as object
    Local oFK1      as object

    jDados["oper"]  := ""
    jDados["tpdoc"] := ""
    jDados["motbx"] := ""
    jDados["iddoc"] := ""
    jDados["valor"] := 0

    nOper    := oModel:GetOperation()
    xOperSE5 := oModel:GetValue("MASTER", "E5_OPERACAO")
    If ValType(xOperSE5) == "N"
        nOperSE5 := xOperSE5
    EndIf

    oFKA    := oModel:GetModel("FKADETAIL")
    oFK1    := oModel:GetModel("FK1DETAIL")
    nLinFKA := oFKA:GetLine()
    nLinFK1 := oFK1:GetLine()

    nI := 1
    While !lAchou .And. nI <= oFKA:Length()
        oFKA:GoLine(nI)
        If !oFKA:IsDeleted() .And. !oFK1:IsEmpty()
            nJ := 1
            While !lAchou .And. nJ <= oFK1:Length()
                oFK1:GoLine(nJ)
                cTpDoc := AllTrim(oFK1:GetValue("FK1_TPDOC"))
                If !oFK1:IsDeleted() .And. (cTpDoc == "VL" .Or. cTpDoc == "BA")
                    lAchou          := .T.
                    jDados["tpdoc"] := cTpDoc
                    jDados["motbx"] := AllTrim(oFK1:GetValue("FK1_MOTBX"))
                    jDados["iddoc"] := oFK1:GetValue("FK1_IDDOC")
                    jDados["valor"] := oFK1:GetValue("FK1_VALOR")
                EndIf
                nJ++
            EndDo
        EndIf
        nI++
    EndDo

    // Restaura o posicionamento usado pelo padrão (FKA primeiro, depois a filha FK1)
    If nLinFKA > 0 .And. nLinFKA <= oFKA:Length()
        oFKA:GoLine(nLinFKA)
    EndIf
    If nLinFK1 > 0 .And. nLinFK1 <= oFK1:Length()
        oFK1:GoLine(nLinFK1)
    EndIf

    If lAchou
        If nOper == MODEL_OPERATION_DELETE .Or. (nOper == MODEL_OPERATION_UPDATE .And. nOperSE5 > 0)
            jDados["oper"] := RS_OPER_ESTOR
        ElseIf nOper == MODEL_OPERATION_INSERT
            jDados["oper"] := RS_OPER_BAIXA
        EndIf
    EndIf
Return jDados

/*/{Protheus.doc} PosicionaTitulo
Posiciona a SE1 no título da baixa a partir do FK1_IDDOC -> FK7 (VAL-003).
Se o SE1 já estiver posicionado no título correto, mantém o posicionamento.
@type static function
@author bacoetrom
@since 13/10/2026
@param cIdDoc, character, FK1_IDDOC do registro principal da baixa
@return logical, .T. quando o título foi localizado
/*/
Static Function PosicionaTitulo(cIdDoc as character) as logical
    Local lRet       := .F. as logical
    Local cQuery     := "" as character
    Local cAliasQry  := "" as character
    Local cChave     := "" as character
    Local oStatement as object

    If Empty(cIdDoc)
        Return lRet
    EndIf

    cQuery := "SELECT FK7.FK7_PREFIX, FK7.FK7_NUM, FK7.FK7_PARCEL, FK7.FK7_TIPO, FK7.FK7_CLIFOR, FK7.FK7_LOJA "
    cQuery += "  FROM " + RetSqlName("FK7") + " FK7 "
    cQuery += " WHERE FK7.D_E_L_E_T_ = ? "
    cQuery += "   AND FK7.FK7_IDDOC = ? "
    cQuery += "   AND FK7.FK7_ALIAS = ? "

    oStatement := FWExecStatement():New(ChangeQuery(cQuery))
    oStatement:SetString(1, " ")
    oStatement:SetString(2, cIdDoc)
    oStatement:SetString(3, "SE1")
    cAliasQry := oStatement:OpenAlias(GetNextAlias())

    If !(cAliasQry)->(Eof())
        cChave := (cAliasQry)->(FK7_CLIFOR + FK7_LOJA + FK7_PREFIX + FK7_NUM + FK7_PARCEL + FK7_TIPO)
        If !SE1->(Eof()) .And. SE1->(E1_CLIENTE + E1_LOJA + E1_PREFIXO + E1_NUM + E1_PARCELA + E1_TIPO) == cChave
            lRet := .T.
        Else
            SE1->(DbSetOrder(2)) // E1_FILIAL+E1_CLIENTE+E1_LOJA+E1_PREFIXO+E1_NUM+E1_PARCELA+E1_TIPO
            lRet := SE1->(DbSeek(xFilial("SE1") + cChave))
        EndIf
    EndIf

    (cAliasQry)->(DbCloseArea())
    oStatement:Destroy()
    oStatement := Nil
Return lRet

/*/{Protheus.doc} LogDiagnostico
Registra no log os dados recebidos pelo ponto de entrada (MV_XRSLOG = .T.).
Usado para as validações VAL-001 a VAL-003 do plano.
@type static function
@author bacoetrom
@since 13/10/2026
@param oModel, object, modelo FINM010
@param cIdPonto, character, ID do ponto de execução
@param jDados, json, dados da baixa lidos por LeDadosBaixa
@return logical, sempre .T.
/*/
Static Function LogDiagnostico(oModel as object, cIdPonto as character, jDados as json) as logical
    Local cMsg := "" as character

    cMsg := "FINM010 DIAG | ID=" + cIdPonto
    cMsg += " | FunName=" + FunName()
    cMsg += " | Oper=" + cValToChar(oModel:GetOperation())
    cMsg += " | E5_OPERACAO=" + cValToChar(oModel:GetValue("MASTER", "E5_OPERACAO"))
    cMsg += " | Linhas FKA=" + cValToChar(oModel:GetModel("FKADETAIL"):Length())
    cMsg += " | RS_OPER=" + jDados["oper"]
    cMsg += " | FK1_TPDOC=" + jDados["tpdoc"]
    cMsg += " | FK1_MOTBX=" + jDados["motbx"]
    cMsg += " | FK1_VALOR=" + cValToChar(jDados["valor"])
    cMsg += " | FK1_IDDOC=" + AllTrim(jDados["iddoc"])
    If !SE1->(Eof())
        cMsg += " | SE1=" + SE1->(E1_FILIAL + E1_PREFIXO + E1_NUM + E1_PARCELA + E1_TIPO)
        cMsg += " | E1_SALDO=" + cValToChar(SE1->E1_SALDO)
        cMsg += " | E1_XSTRIC=" + SE1->E1_XSTRIC
    EndIf
    U_PXRSLog("INFO", cMsg)
Return .T.
